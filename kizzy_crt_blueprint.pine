string keyMode = input.string("One step higher", "Key level TF", ["One step higher", "Same as CRT TF", "Fixed"], inline = "ktf", group = G_KEY,
     tooltip = "Romeo-style top-down: key levels come from a HIGHER timeframe than the CRT candle.\nOne step higher: ≤1H → 4H, 4H → D, D → W, W → M.\nFixed: use the TF on the right for every row.")
string keyFix  = input.timeframe("D", "", inline = "ktf", group = G_KEY)
