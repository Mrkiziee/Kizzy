// ═════════════════════════════════════════════════════════════════════════════
// HELPERS
// ═════════════════════════════════════════════════════════════════════════════
// CRT kinds
const int K_CL = 1
const int K_2C = 2   // two candle, still running
const int K_2D = 3   // two candle, range already delivered by C2
const int K_DP = 4
const int K_IB = 5

f_name(int k) =>
    switch k
        K_CL => "Classic"
        K_2C => "Two Candle"
        K_2D => "Two Candle"
        K_DP => "Double Purge"
        K_IB => "Inside Bar"
        => ""

f_code(int k) =>
    switch k
        K_CL => "CL"
        K_2C => "2C"
        K_2D => "2C"
        K_DP => "DP"
        K_IB => "IB"
        => ""

// Key-level bit mask: 1 OHP/OLP · 2 RB · 4 OB · 8 FVG · 16 OCL · 32 IFVG
f_keyText(int mask, int dir) =>
    string s = ""
    int    m = mask
    array<string> nm = array.from(dir == 1 ? "OLP" : "OHP", "RB", "OB", "FVG", "OCL", "IFVG")
    for n in nm
        if m % 2 == 1
            s := s + (s == "" ? "" : "+") + n
        m := int(math.floor(m / 2))
    s

f_style(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_tfLabel(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec < 3600 ? str.tostring(math.round(sec / 60)) + "m" : sec < 86400 ? str.tostring(math.round(sec / 3600)) + "H" : sec < 604800 ? str.tostring(math.round(sec / 86400)) + "D" : tf

f_px(float x) =>
    str.tostring(x, format.mintick)

f_pos(string p) =>
    switch p
        "Top Right"   => position.top_right
        "Bottom Left" => position.bottom_left
        "Top Left"    => position.top_left
        => position.bottom_right

f_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

// Range candle is "decisive": total wick ≤ maxWick % of body.
f_rangeOk(float o, float h, float l, float c) =>
    float body = math.abs(c - o)
    maxWick <= 0 or (body > 0 and (h - l) - body <= body * maxWick / 100)

// Sweep-and-close-back-inside rule. Range candle (1) vs sweep candle (2). Returns [bearish, bullish].
f_detect(float o1, float h1, float l1, float c1, float o2, float h2, float l2, float c2) =>
    bool sweptH = h2 > h1
    bool sweptL = l2 < l1
    bool inside = c2 < h1 and c2 > l1
    bool bear   = sweptH and not sweptL and inside
    bool bull   = sweptL and not sweptH and inside
    if qualityOnly
        bool openIn = o2 <= h1 and o2 >= l1
        bear := bear and openIn
        bull := bull and openIn
    if oppColor
        bear := bear and c1 > o1 and c2 < o2
        bull := bull and c1 < o1 and c2 > o2
    bool ok = f_rangeOk(o1, h1, l1, c1)
    [bear and ok, bull and ok]

// ─── key-level storage helpers (run on the HTF) ──────────────────────────────
// Every level / zone keeps its birth time (close time of the key-TF bar that created / confirmed it),
// so a check only uses levels that existed BEFORE the sweep candle opened.
f_pushL(array<float> a, array<int> tm, float v, int born) =>
    a.unshift(v)
    tm.unshift(born)
    if a.size() > keyMax
        a.pop()
        tm.pop()

f_pushZ(array<float> t, array<float> b, array<int> tm, float top, float bot, int born) =>
    t.unshift(top)
    b.unshift(bot)
    tm.unshift(born)
    if t.size() > keyMax
        t.pop()
        b.pop()
        tm.pop()

// level purged by the wick (h / l), close (c) back on the other side
f_lvlBear(array<float> lv, array<int> tm, float h, float c, int st) =>
    float r = na
    for [i, v] in lv
        if tm.get(i) <= st and h >= v and c < v
            r := v
            break
    r

f_lvlBull(array<float> lv, array<int> tm, float l, float c, int st) =>
    float r = na
    for [i, v] in lv
        if tm.get(i) <= st and l <= v and c > v
            r := v
            break
    r

// wick taps the zone and closes back away from it
f_zoneBear(array<float> t, array<float> b, array<int> tm, float h, float c, int st) =>
    float r = na
    for [i, top] in t
        float bot = b.get(i)
        if tm.get(i) <= st and h >= bot and c < top
            r := bot
            break
    r

f_zoneBull(array<float> t, array<float> b, array<int> tm, float l, float c, int st) =>
    float r = na
    for [i, top] in t
        float bot = b.get(i)
        if tm.get(i) <= st and l <= top and c > bot
            r := top
            break
    r

// remove levels / zones that the key-TF bar CLOSED (cl) through
f_dropLvl(array<float> a, array<int> tm, bool above, float cl) =>
    if a.size() > 0
        for i = a.size() - 1 to 0
            float v = a.get(i)
            if (above and cl > v) or (not above and cl < v)
                a.remove(i)
                tm.remove(i)

f_dropZone(array<float> t, array<float> b, array<int> tm, bool above, float cl) =>
    if t.size() > 0
        for i = t.size() - 1 to 0
            if (above and cl > t.get(i)) or (not above and cl < b.get(i))
                t.remove(i)
                b.remove(i)
                tm.remove(i)

// FVG closed through → moves to the inverse list
f_invert(array<float> st, array<float> sb, array<int> stm, array<float> dt, array<float> db, array<int> dtm, bool up, float cl, int born) =>
    if st.size() > 0
        for i = st.size() - 1 to 0
            float t = st.get(i)
            float b = sb.get(i)
            if (up and cl > t) or (not up and cl < b)
                st.remove(i)
                sb.remove(i)
                stm.remove(i)
                f_pushZ(dt, db, dtm, t, b, born)

f_mask(float v1, float v2, float v3, float v4, float v5, float v6) =>
    int   m   = 0
    float p   = na
    int   bit = 1
    for v in array.from(v1, v2, v3, v4, v5, v6)
        if not na(v)
            m += bit
            if na(p)
                p := v
        bit *= 2
    [m, p]

// Key-TF candles rebuilt from chart bars (no request.security → constant, small memory).
// Arrays are newest first: index 0 = last CLOSED key-TF candle.
type KeyStore
    // closed key-TF candles
    array<float> bo
    array<float> bh
    array<float> bl
    array<float> bc
    // candle being built
    float curO
    float curH
    float curL
    float curC
    // levels (value + birth time)
    array<float> pvH
    array<int>   pvHM
    array<float> pvL
    array<int>   pvLM
    array<float> ocH
    array<int>   ocHM
    array<float> ocL
    array<int>   ocLM
    // zones (top + bottom + birth time)
    array<float> rbHT
    array<float> rbHB
    array<int>   rbHM
    array<float> rbLT
    array<float> rbLB
    array<int>   rbLM
    array<float> obBT
    array<float> obBB
    array<int>   obBM
    array<float> obST
    array<float> obSB
    array<int>   obSM
    array<float> fvBT
    array<float> fvBB
    array<int>   fvBM
    array<float> fvST
    array<float> fvSB
    array<int>   fvSM
    array<float> ifBT
    array<float> ifBB
    array<int>   ifBM
    array<float> ifST
    array<float> ifSB
    array<int>   ifSM

f_af() =>
    array.new<float>()

f_ai() =>
    array.new<int>()

f_newStore() =>
    KeyStore.new(f_af(), f_af(), f_af(), f_af(), na, na, na, na,
         f_af(), f_ai(), f_af(), f_ai(), f_af(), f_ai(), f_af(), f_ai(),
         f_af(), f_af(), f_ai(), f_af(), f_af(), f_ai(),
         f_af(), f_af(), f_ai(), f_af(), f_af(), f_ai(),
         f_af(), f_af(), f_ai(), f_af(), f_af(), f_ai(),
         f_af(), f_af(), f_ai(), f_af(), f_af(), f_ai())

// pivot: candle at index n is strictly above (isHigh) / below all candles within n on both sides
f_isPivot(array<float> v, int n, bool isHigh) =>
    bool ok = v.size() >= 2 * n + 1
    if ok
        float c = v.get(n)
        for i = 0 to 2 * n
            if i != n
                float x = v.get(i)
                if (isHigh and x >= c) or (not isHigh and x <= c)
                    ok := false
                    break
    ok

// Processes one CLOSED key-TF candle (already pushed at index 0). born = its close time.
method onClose(KeyStore k, int born) =>
    float c0 = k.bc.get(0)
    float h0 = k.bh.get(0)
    float l0 = k.bl.get(0)

    f_dropLvl(k.pvH, k.pvHM, true, c0)
    f_dropLvl(k.pvL, k.pvLM, false, c0)
    f_dropLvl(k.ocH, k.ocHM, true, c0)
    f_dropLvl(k.ocL, k.ocLM, false, c0)
    f_dropZone(k.rbHT, k.rbHB, k.rbHM, true, c0)
    f_dropZone(k.rbLT, k.rbLB, k.rbLM, false, c0)
    f_dropZone(k.obST, k.obSB, k.obSM, true, c0)
    f_dropZone(k.obBT, k.obBB, k.obBM, false, c0)
    f_dropZone(k.ifST, k.ifSB, k.ifSM, true, c0)
    f_dropZone(k.ifBT, k.ifBB, k.ifBM, false, c0)
    f_invert(k.fvBT, k.fvBB, k.fvBM, k.ifST, k.ifSB, k.ifSM, false, c0, born)   // bullish FVG closed below → resistance IFVG
    f_invert(k.fvST, k.fvSB, k.fvSM, k.ifBT, k.ifBB, k.ifBM, true, c0, born)    // bearish FVG closed above → support IFVG

    int n = k.bc.size()
    // swings (candle at index keyLen, confirmed now)
    if n >= 2 * keyLen + 1
        float po = k.bo.get(keyLen)
        float pc = k.bc.get(keyLen)
        if f_isPivot(k.bh, keyLen, true)
            float ph = k.bh.get(keyLen)
            f_pushL(k.pvH, k.pvHM, ph, born)
            f_pushZ(k.rbHT, k.rbHB, k.rbHM, ph, math.max(po, pc), born)
        if f_isPivot(k.bl, keyLen, false)
            float pl = k.bl.get(keyLen)
            f_pushL(k.pvL, k.pvLM, pl, born)
            f_pushZ(k.rbLT, k.rbLB, k.rbLM, math.min(po, pc), pl, born)
        array<float> bTop = array.new<float>()
        array<float> bBot = array.new<float>()
        for i = 0 to 2 * keyLen
            bTop.push(math.max(k.bo.get(i), k.bc.get(i)))
            bBot.push(math.min(k.bo.get(i), k.bc.get(i)))
        if f_isPivot(bTop, keyLen, true)
            f_pushL(k.ocH, k.ocHM, bTop.get(keyLen), born)
        if f_isPivot(bBot, keyLen, false)
            f_pushL(k.ocL, k.ocLM, bBot.get(keyLen), born)
    // FVG (3 candles) and OB (2 candles)
    if n >= 3
        if l0 > k.bh.get(2)
            f_pushZ(k.fvBT, k.fvBB, k.fvBM, l0, k.bh.get(2), born)
        if h0 < k.bl.get(2)
            f_pushZ(k.fvST, k.fvSB, k.fvSM, k.bl.get(2), h0, born)
    if n >= 2
        float o1 = k.bo.get(1)
        float c1 = k.bc.get(1)
        if c1 < o1 and c0 > k.bh.get(1)
            f_pushZ(k.obBT, k.obBB, k.obBM, k.bh.get(1), k.bl.get(1), born)
        if c1 > o1 and c0 < k.bl.get(1)
            f_pushZ(k.obST, k.obSB, k.obSM, k.bh.get(1), k.bl.get(1), born)

// Call on EVERY chart bar. newBar = timeframe.change(keyTF).
method feed(KeyStore k, bool newBar) =>
    if newBar and not na(k.curO)
        // the previous key-TF candle just closed
        k.bo.unshift(k.curO)
        k.bh.unshift(k.curH)
        k.bl.unshift(k.curL)
        k.bc.unshift(k.curC)
        if k.bo.size() > math.max(2 * keyLen + 2, biasN)
            k.bo.pop()
            k.bh.pop()
            k.bl.pop()
            k.bc.pop()
        k.onClose(time)
    if newBar or na(k.curO)
        k.curO := open
        k.curH := high
        k.curL := low
    else
        k.curH := math.max(k.curH, high)
        k.curL := math.min(k.curL, low)
    k.curC := close

// premium / discount range of the last N closed key-TF candles → [high, low]
method biasRange(KeyStore k) =>
    float hi = na
    float lo = na
    int   n  = math.min(biasN, k.bh.size())
    if n > 0
        for i = 0 to n - 1
            hi := na(hi) ? k.bh.get(i) : math.max(hi, k.bh.get(i))
            lo := na(lo) ? k.bl.get(i) : math.min(lo, k.bl.get(i))
    [hi, lo]

// Tests a sweep candle (h, l, c, open time st) against a key store. Returns [bitMask, firstLevelPrice].
f_keyCheck(KeyStore k, int dir, float h, float l, float c, int st) =>
    int   mask = 0
    float px   = na
    if dir == -1
        [m, p] = f_mask(kOX ? f_lvlBear(k.pvH, k.pvHM, h, c, st) : na, kRB ? f_zoneBear(k.rbHT, k.rbHB, k.rbHM, h, c, st) : na,
             kOB ? f_zoneBear(k.obST, k.obSB, k.obSM, h, c, st) : na, kFVG ? f_zoneBear(k.fvST, k.fvSB, k.fvSM, h, c, st) : na,
             kOCL ? f_lvlBear(k.ocH, k.ocHM, h, c, st) : na, kIFVG ? f_zoneBear(k.ifST, k.ifSB, k.ifSM, h, c, st) : na)
        mask := m
        px   := p
    else if dir == 1
        [m, p] = f_mask(kOX ? f_lvlBull(k.pvL, k.pvLM, l, c, st) : na, kRB ? f_zoneBull(k.rbLT, k.rbLB, k.rbLM, l, c, st) : na,
             kOB ? f_zoneBull(k.obBT, k.obBB, k.obBM, l, c, st) : na, kFVG ? f_zoneBull(k.fvBT, k.fvBB, k.fvBM, l, c, st) : na,
             kOCL ? f_lvlBull(k.ocL, k.ocLM, l, c, st) : na, kIFVG ? f_zoneBull(k.ifBT, k.ifBB, k.ifBM, l, c, st) : na)
        mask := m
        px   := p
    [mask, px]

// Key-level TF for a CRT TF
f_keyTF(string tf) =>
    int s = timeframe.in_seconds(tf)
    string nxt = s <= 3600 ? "240" : s <= 14400 ? "D" : s <= 86400 ? "W" : "M"
    keyMode == "Same as CRT TF" ? tf : keyMode == "Fixed" ? keyFix : nxt

// Runs ON THE HIGHER TIMEFRAME. The current HTF bar is the candidate sweep candle.
// Returns [kind, dir, rangeHigh, rangeLow, invalidation, rangeTime].
f_classify() =>
    int   kind = 0
    int   dir  = 0
    float rh   = na
    float rl   = na
    float iv   = na
    int   tr   = na

    // 4 · Double Purge – range = [2], [1] purges one side, current bar purges the other side
    if useDP
        float h0   = high[2]
        float l0   = low[2]
        bool  c1In = close[1] < h0 and close[1] > l0
        bool  c0In = close < h0 and close > l0
        bool  p1Hi = high[1] > h0 and low[1] >= l0 and c1In
        bool  p1Lo = low[1] < l0 and high[1] <= h0 and c1In
        bool  p0Hi = high > h0 and low >= l0 and c0In
        bool  p0Lo = low < l0 and high <= h0 and c0In
        if f_rangeOk(open[2], h0, l0, close[2]) and ((p1Hi and p0Lo) or (p1Lo and p0Hi))
            kind := K_DP
            dir  := p0Lo ? 1 : -1
            rh   := h0
            rl   := l0
            iv   := p0Lo ? low : high
            tr   := time[2]

    // 5 · Inside Bar – mother bar [k] with bars [1..k-1] inside it, current bar sweeps the mother
    if kind == 0 and useIB
        for k = 2 to maxIB + 1
            float mh    = high[k]
            float ml    = low[k]
            bool  allIn = true
            for j = 1 to k - 1
                if high[j] > mh or low[j] < ml
                    allIn := false
                    break
            if allIn
                [bear, bull] = f_detect(open[k], mh, ml, close[k], open, high, low, close)
                if bear or bull
                    kind := K_IB
                    dir  := bull ? 1 : -1
                    rh   := mh
                    rl   := ml
                    iv   := bull ? low : high
                    tr   := time[k]
                break

    // 2 · Two Candle – opposite colour, big body, sweeps one side of [1]
    if kind == 0 and use2C
        float h1     = high[1]
        float l1     = low[1]
        float b1     = math.abs(close[1] - open[1])
        bool  opp    = (close[1] > open[1] and close < open) or (close[1] < open[1] and close > open)
        bool  bigB   = math.abs(close - open) >= b1 * c2Body / 100
        bool  openIn = not qualityOnly or (open <= h1 and open >= l1)
        bool  bear   = high > h1 and close < open and close < h1
        bool  bull   = low < l1 and close > open and close > l1
        if opp and bigB and openIn and f_rangeOk(open[1], h1, l1, close[1]) and (bull or bear)
            bool delivered = bull ? close > h1 : close < l1
            kind := delivered ? K_2D : K_2C
            dir  := bull ? 1 : -1
            rh   := h1
            rl   := l1
            iv   := bull ? low : high
            tr   := time[1]

    // 1 · Classic – range = [1]
    if kind == 0 and useCL
        [bear, bull] = f_detect(open[1], high[1], low[1], close[1], open, high, low, close)
        if bear or bull
            kind := K_CL
            dir  := bull ? 1 : -1
            rh   := high[1]
            rl   := low[1]
            iv   := bull ? low : high
            tr   := time[1]

    [kind, dir, rh, rl, iv, tr]

// Classification of the last CLOSED HTF candle (non-repainting: [1] + lookahead_on).
f_htf() =>
    [k, d, rh, rl, iv, tr] = f_classify()
    [k[1], d[1], rh[1], rl[1], iv[1], tr[1]]

// Last two CLOSED HTF candles, for the mini candles and the live check.
f_pair() =>
    [open[2], high[2], low[2], close[2], open[1], high[1], low[1], close[1], time[1]]

// ═════════════════════════════════════════════════════════════════════════════
// CRT STATE
// ═════════════════════════════════════════════════════════════════════════════
type Crt
    string tf
    string lbl
    string sty
    string klbl            // key-level TF label
    int    kind    = 0
    int    dir     = 0
    float  crh
    float  crl
    float  tp1
    float  tp2
    float  inval
    int    keyMask = 0
    float  keyPx
    string pd      = ""    // "Disc" / "Prem" of the sweep inside the key-TF range
    bool   tp1Hit  = false
    bool   done    = false
    int    result  = 0     // 1 = TP2 reached, -1 = invalidated
    int    age     = 0     // HTF candles since confirmation
    bool   multi   = false
    float  c3o
    float  c3h
    float  c3l
    line   lH
    line   lL
    line   lT
    line   lK
    label  bH
    label  bL
    label  bT
    label  bK
    label  bM              // "Manipulation" under / over the sweep wick
    float  tbsLvl          // chart-TF swing level the body closed through
    int    tbsBar
    float  tbsExt          // extreme of the soup (stop)
    bool   entered = false
    bool   inTrade = false
    float  sl

method clearDraw(Crt s) =>
    line.delete(s.lH)
    line.delete(s.lL)
    line.delete(s.lT)
    line.delete(s.lK)
    label.delete(s.bH)
    label.delete(s.bL)
    label.delete(s.bT)
    label.delete(s.bK)
    label.delete(s.bM)

method freeze(Crt s) =>
    for l in array.from(s.lH, s.lL, s.lT, s.lK)
        if not na(l)
            l.set_extend(extend.none)
            l.set_x2(time)

method keyText(Crt s) =>
    string k = s.keyMask > 0 ? "🔑 " + f_keyText(s.keyMask, s.dir) + " " + s.klbl : ""
    s.dir == 0 ? "" : k + (s.pd != "" ? (k != "" ? " · " : "") + s.pd : "")

method statusText(Crt s) =>
    string base = f_name(s.kind) + (s.dir == 1 ? " ▲" : " ▼")
    string r = ""
    if s.dir == 0
        r := "Waiting"
    else if s.result == 1
        r := base + (s.multi ? " · MC" : "") + " · TP2 ✓"
    else if s.result == -1
        r := base + (s.tp1Hit ? " · TP1 ✓ / stop" : " · ✗")
    else
        r := base + (s.tp1Hit ? " · TP1 ✓" : "") + (s.age > 0 ? " · +" + str.tostring(s.age) : "")
    r

method start(Crt s, int kind, int dir, float rh, float rl, float iv, int tr, int km, float kp, int sweepT) =>
    if keepHist
        s.freeze()
    else
        s.clearDraw()
    s.kind    := kind
    s.dir     := dir
    s.crh     := rh
    s.crl     := rl
    s.tp1     := (rh + rl) / 2
    s.tp2     := dir == -1 ? rl : rh
    s.inval   := iv
    s.keyMask := km
    s.keyPx   := kp
    s.tp1Hit  := false
    s.done    := false
    s.result  := 0
    s.age     := 0
    s.multi   := false
    s.lK      := na
    s.bK      := na
    s.bM      := label.new(sweepT, iv, "Manipulation", xloc.bar_time, yloc.price, color(na), dir == 1 ? label.style_label_up : label.style_label_down, lvlCol, size.tiny)
    s.tbsLvl  := na
    s.entered := false
    s.inTrade := false
    string st  = f_style(s.sty)
    color  dc  = dir == 1 ? bullCol : bearCol
    string tag = " " + f_code(kind)
    string hTxt = "CRH " + s.lbl + (dir == -1 ? " ▼" + tag : "") + (showTP and dir == 1 ? " | TP2" : "")
    string lTxt = "CRL " + s.lbl + (dir == 1 ? " ▲" + tag : "") + (showTP and dir == -1 ? " | TP2" : "")
    s.lH := line.new(tr, rh, time, rh, xloc.bar_time, extend.right, dir == -1 ? dc : lvlCol, st, 1)
    s.lL := line.new(tr, rl, time, rl, xloc.bar_time, extend.right, dir == 1 ? dc : lvlCol, st, 1)
    s.bH := label.new(time, rh, hTxt, xloc.bar_time, yloc.price, color(na), label.style_label_left, dir == -1 ? dc : lvlCol, size.small)
    s.bL := label.new(time, rl, lTxt, xloc.bar_time, yloc.price, color(na), label.style_label_left, dir == 1 ? dc : lvlCol, size.small)
    if showTP
        s.lT := line.new(tr, s.tp1, time, s.tp1, xloc.bar_time, extend.right, color.new(dc, 30), line.style_dashed, 1)
        s.bT := label.new(time, s.tp1, "TP1 " + s.lbl + " (50%)", xloc.bar_time, yloc.price, color(na), label.style_label_left, dc, size.small)
    if showKey and km > 0 and not na(kp)
        s.lK := line.new(tr, kp, time, kp, xloc.bar_time, extend.right, keyCol, line.style_dotted, 1)
        s.bK := label.new(time, kp, f_keyText(km, dir) + " 🔑 " + s.klbl, xloc.bar_time, yloc.price, color(na), label.style_label_left, keyCol, size.small)
    // Two Candle (delivered): C2 already ran through the whole range
    if kind == K_2D
        s.tp1Hit := true
        s.done   := true
        s.result := 1
        s.freeze()

// Follows an active CRT on every chart bar. Returns [tp1Hit, tp2Hit, invalidated] events.
method track(Crt s) =>
    bool e1 = false
    bool e2 = false
    bool ei = false
    if s.dir != 0 and not s.done
        bool hitTp1 = s.dir == -1 ? low <= s.tp1 : high >= s.tp1
        bool hitTp2 = s.dir == -1 ? low <= s.tp2 : high >= s.tp2
        bool broke  = s.dir == -1 ? high > s.inval : low < s.inval
        if not s.tp1Hit and hitTp1
            s.tp1Hit := true
            e1 := true
            if not na(s.bT)
                s.bT.set_text("TP1 " + s.lbl + " ✓")
        if hitTp2
            s.done   := true
            s.result := 1
            s.multi  := useMC and s.age >= 1
            e2 := true
        else if broke
            s.done   := true
            s.result := -1
            ei := true
        if s.done
            s.freeze()
    [e1, e2, ei]

// Turtle Body Soup entry on the chart TF. ph/pl = latest chart-TF swing high/low.
// Returns [entry, win (TP1 before SL), loss (SL first)].
method tbs(Crt s, float ph, float pl) =>
    bool ent = false
    bool win = false
    bool los = false
    if s.inTrade
        bool hitSL = s.dir == -1 ? high >= s.sl : low <= s.sl
        bool hitTP = s.dir == -1 ? low <= s.tp1 : high >= s.tp1
        if hitSL
            s.inTrade := false
            los := true
        else if hitTP
            s.inTrade := false
            win := true
    else if useTBS and s.dir != 0 and not s.done and not s.entered and not s.tp1Hit
        float lvl = s.dir == -1 ? ph : pl
        if na(s.tbsLvl)
            if not na(lvl)
                bool farSide  = s.dir == -1 ? lvl > s.tp1 : lvl < s.tp1
                bool bodyOut  = s.dir == -1 ? close > lvl and close[1] <= lvl : close < lvl and close[1] >= lvl
                bool wickOnly = s.dir == -1 ? high > lvl and close < lvl : low < lvl and close > lvl
                if farSide and bodyOut
                    s.tbsLvl := lvl
                    s.tbsBar := bar_index
                    s.tbsExt := s.dir == -1 ? high : low
                else if farSide and allowTWS and wickOnly
                    ent  := true
                    s.sl := s.dir == -1 ? high : low
        else
            s.tbsExt := s.dir == -1 ? math.max(s.tbsExt, high) : math.min(s.tbsExt, low)
            bool back = s.dir == -1 ? close < s.tbsLvl : close > s.tbsLvl
            if back
                ent  := true
                s.sl := s.tbsExt
            else if bar_index - s.tbsBar >= tbsWin
                s.tbsLvl := na
        if ent
            s.entered := true
            s.inTrade := true
            s.tbsLvl  := na
    [ent, win, los]

method moveLabels(Crt s, int x) =>
    if s.dir != 0 and not s.done
        for b in array.from(s.bH, s.bL, s.bT, s.bK)
            if not na(b)
                b.set_x(x)

// One timeframe, one chart bar. `tf` is passed separately so it stays a simple string.
// NY hour of a timestamp is in the "1,5,9" list
f_hourOk(int t) =>
    string h  = str.tostring(hour(t, "America/New_York"))
    bool   ok = false
    for x in str.split(timeHours, ",")
        if str.trim(x) == h
            ok := true
    ok

// ks = key store (closed key-TF candles),
// bh/bl = premium-discount range, sh/sl/sc/st = sweep candle high/low/close/open time.
f_step(Crt s, string tf, bool on, int kind, int dir, float rh, float rl, float iv, int tr,
     KeyStore ks, float bh, float bl, float sh, float sl, float sc, int st) =>
    bool newHtf = timeframe.change(tf)
    // live (still open) HTF candle, built from chart bars
    if newHtf or na(s.c3o)
        s.c3o := open
        s.c3h := high
        s.c3l := low
    else
        s.c3h := math.max(s.c3h, high)
        s.c3l := math.min(s.c3l, low)
    if newHtf and s.dir != 0 and not s.done
        s.age += 1
    bool nBull = false
    bool nBear = false
    if on and newHtf and kind != 0 and not na(rh)
        // only key levels that existed BEFORE the sweep candle opened
        [km, kp] = f_keyCheck(ks, dir, sh, sl, sc, st)
        float eq    = (bh + bl) / 2
        float tip   = dir == 1 ? sl : sh
        bool  pdOk  = not useBias or na(eq) or (dir == 1 ? tip <= eq : tip >= eq)
        bool  keyOk = not reqKey or km > 0
        bool  timeOk = not useTime or timeframe.in_seconds(tf) != 14400 or f_hourOk(st)
        if pdOk and keyOk and timeOk
            s.start(kind, dir, rh, rl, iv, tr, km, kp, st)
            s.pd  := na(eq) ? "" : tip < eq ? "Disc" : "Prem"
            nBull := dir == 1
            nBear := dir == -1
    [e1, e2, ei] = s.track()
    [nBull, nBear, e1, e2, ei]

f_alert(Crt s, bool nBull, bool nBear, bool e1, bool e2, bool ei) =>
    string sym = syminfo.ticker
    string nm  = f_name(s.kind)
    string dr  = s.dir == 1 ? "BULL" : "BEAR"
    string ky  = s.keyMask > 0 ? " | Key: " + f_keyText(s.keyMask, s.dir) : ""
    if alNew and (nBull or nBear)
        string head  = str.format("📢 Kizzy - CRT {0} {1} | {2}", s.lbl, nBull ? "BULL 🟢" : "BEAR 🔴", sym)
        string body  = s.kind == K_2D ? "\n✅ Range already delivered" : str.format("\n⚖️ TP1 (50%): {0}\n🎯 TP2: {1}\n🛑 Invalid: {2}", f_px(s.tp1), f_px(s.tp2), f_px(s.inval))
        string info  = "\n📐 " + nm + (s.keyMask > 0 ? " · 🔑 " + f_keyText(s.keyMask, s.dir) + " " + s.klbl : "")
        alert(head + body + info, alert.freq_once_per_bar)
    if alTP1 and e1
        alert(str.format("{0} | {1} {2} CRT {3} | TP1 hit ✓ {4}", sym, s.lbl, nm, dr, f_px(s.tp1)), alert.freq_once_per_bar)
    if alTP2 and e2
        alert(str.format("{0} | {1} {2} CRT {3}{4} | TP2 hit ✓ {5}", sym, s.lbl, nm, dr, s.multi ? " (Multiple Candle)" : "", f_px(s.tp2)), alert.freq_once_per_bar)
    if alInv and ei
        alert(str.format("{0} | {1} {2} CRT {3} | invalidated beyond {4}", sym, s.lbl, nm, dr, f_px(s.inval)), alert.freq_once_per_bar)

// ═════════════════════════════════════════════════════════════════════════════
// DATA + ENGINE
// ═════════════════════════════════════════════════════════════════════════════
int chartSec = timeframe.in_seconds(timeframe.period)
bool on1 = tf1On and timeframe.in_seconds(tf1) >= chartSec
bool on2 = tf2On and timeframe.in_seconds(tf2) >= chartSec
bool on3 = tf3On and timeframe.in_seconds(tf3) >= chartSec

[a_k, a_d, a_rh, a_rl, a_iv, a_tr] = request.security(syminfo.tickerid, on1 ? tf1 : timeframe.period, f_htf(), lookahead = barmerge.lookahead_on)
[b_k, b_d, b_rh, b_rl, b_iv, b_tr] = request.security(syminfo.tickerid, on2 ? tf2 : timeframe.period, f_htf(), lookahead = barmerge.lookahead_on)
[c_k, c_d, c_rh, c_rl, c_iv, c_tr] = request.security(syminfo.tickerid, on3 ? tf3 : timeframe.period, f_htf(), lookahead = barmerge.lookahead_on)

[a_o1, a_h1, a_l1, a_c1, a_o2, a_h2, a_l2, a_c2, a_t2] = request.security(syminfo.tickerid, on1 ? tf1 : timeframe.period, f_pair(), lookahead = barmerge.lookahead_on)
[b_o1, b_h1, b_l1, b_c1, b_o2, b_h2, b_l2, b_c2, b_t2] = request.security(syminfo.tickerid, on2 ? tf2 : timeframe.period, f_pair(), lookahead = barmerge.lookahead_on)
[c_o1, c_h1, c_l1, c_c1, c_o2, c_h2, c_l2, c_c2, c_t2] = request.security(syminfo.tickerid, on3 ? tf3 : timeframe.period, f_pair(), lookahead = barmerge.lookahead_on)

// key-level stores, fed from chart bars (key TF ≥ CRT TF ≥ chart TF)
var KeyStore ks1 = f_newStore()
var KeyStore ks2 = f_newStore()
var KeyStore ks3 = f_newStore()
bool kNew1 = timeframe.change(f_keyTF(tf1))
bool kNew2 = timeframe.change(f_keyTF(tf2))
bool kNew3 = timeframe.change(f_keyTF(tf3))
if on1
    ks1.feed(kNew1)
if on2
    ks2.feed(kNew2)
if on3
    ks3.feed(kNew3)
[a_bh, a_bl] = ks1.biasRange()
[b_bh, b_bl] = ks2.biasRange()
[c_bh, c_bl] = ks3.biasRange()

var Crt s1 = Crt.new(tf1, f_tfLabel(tf1), tf1Sty, f_tfLabel(f_keyTF(tf1)))
var Crt s2 = Crt.new(tf2, f_tfLabel(tf2), tf2Sty, f_tfLabel(f_keyTF(tf2)))
var Crt s3 = Crt.new(tf3, f_tfLabel(tf3), tf3Sty, f_tfLabel(f_keyTF(tf3)))

[n1u, n1d, e11, e12, e1i] = f_step(s1, tf1, on1, a_k, a_d, a_rh, a_rl, a_iv, a_tr, ks1, a_bh, a_bl, a_h2, a_l2, a_c2, a_t2)
[n2u, n2d, e21, e22, e2i] = f_step(s2, tf2, on2, b_k, b_d, b_rh, b_rl, b_iv, b_tr, ks2, b_bh, b_bl, b_h2, b_l2, b_c2, b_t2)
[n3u, n3d, e31, e32, e3i] = f_step(s3, tf3, on3, c_k, c_d, c_rh, c_rl, c_iv, c_tr, ks3, c_bh, c_bl, c_h2, c_l2, c_c2, c_t2)

f_alert(s1, n1u, n1d, e11, e12, e1i)
f_alert(s2, n2u, n2d, e21, e22, e2i)
f_alert(s3, n3u, n3d, e31, e32, e3i)

// ─── statistics (index = CRT kind; 0 = TBS entries) ─────────────────────────
var array<int> stN   = array.new<int>(6, 0)
var array<int> stT1  = array.new<int>(6, 0)
var array<int> stT2  = array.new<int>(6, 0)
var array<int> stInv = array.new<int>(6, 0)
var array<int> stMC  = array.new<int>(6, 0)

f_stats(Crt s, bool nBull, bool nBear, bool e1, bool e2, bool ei) =>
    if s.kind != K_2D and s.kind > 0
        if nBull or nBear
            stN.set(s.kind, stN.get(s.kind) + 1)
        if e1
            stT1.set(s.kind, stT1.get(s.kind) + 1)
        if e2
            stT2.set(s.kind, stT2.get(s.kind) + 1)
            if s.multi
                stMC.set(s.kind, stMC.get(s.kind) + 1)
        if ei
            stInv.set(s.kind, stInv.get(s.kind) + 1)

f_stats(s1, n1u, n1d, e11, e12, e1i)
f_stats(s2, n2u, n2d, e21, e22, e2i)
f_stats(s3, n3u, n3d, e31, e32, e3i)

// ─── TBS entries on the chart TF ─────────────────────────────────────────────
float lph = ta.pivothigh(high, tbsLen, tbsLen)
float lpl = ta.pivotlow(low, tbsLen, tbsLen)
var float lastPH = na
var float lastPL = na
if not na(lph)
    lastPH := lph
if not na(lpl)
    lastPL := lpl

f_tbsOut(Crt s, bool ent, bool win, bool los) =>
    if ent
        stN.set(0, stN.get(0) + 1)
        color  dc  = s.dir == 1 ? bullCol : bearCol
        string tip = str.format("TBS {0} {1} CRT\nEntry: {2}\nSL: {3}\nTP1: {4}\nTP2: {5}", s.lbl, f_name(s.kind), f_px(close), f_px(s.sl), f_px(s.tp1), f_px(s.tp2))
        label.new(bar_index, s.dir == 1 ? low : high, "TBS " + s.lbl, xloc.bar_index, yloc.price, dc,
             s.dir == 1 ? label.style_label_up : label.style_label_down, color.white, size.small, tooltip = tip)
        if alTBS
            alert(str.format("{0} | TBS {1} entry {2} ({3} CRT) | Entry: {4} | SL: {5} | TP1: {6} | TP2: {7}", syminfo.ticker,
                 s.dir == 1 ? "BUY 🟢" : "SELL 🔴", s.lbl, f_name(s.kind), f_px(close), f_px(s.sl), f_px(s.tp1), f_px(s.tp2)), alert.freq_once_per_bar_close)
    if win
        stT1.set(0, stT1.get(0) + 1)
    if los
        stInv.set(0, stInv.get(0) + 1)

[t1e, t1w, t1l] = s1.tbs(lastPH, lastPL)
f_tbsOut(s1, t1e, t1w, t1l)
[t2e, t2w, t2l] = s2.tbs(lastPH, lastPL)
f_tbsOut(s2, t2e, t2w, t2l)
[t3e, t3w, t3l] = s3.tbs(lastPH, lastPL)
f_tbsOut(s3, t3e, t3w, t3l)

// Small markers on the bar where a CRT is confirmed
bool anyBull = n1u or n2u or n3u
bool anyBear = n1d or n2d or n3d
plotshape(anyBull, "Bull CRT", shape.triangleup, location.belowbar, bullCol, size = size.tiny)
plotshape(anyBear, "Bear CRT", shape.triangledown, location.abovebar, bearCol, size = size.tiny)

// ═════════════════════════════════════════════════════════════════════════════
// SESSIONS
// ═════════════════════════════════════════════════════════════════════════════
bool sesOk = showSes and timeframe.isintraday and chartSec <= 3600
bgcolor(sesOk and not na(time(timeframe.period, asiaS, sesTz)) ? asiaC : na, title = "Asia")
bgcolor(sesOk and not na(time(timeframe.period, lonS, sesTz)) ? lonC : na, title = "London")
bgcolor(sesOk and not na(time(timeframe.period, nyS, sesTz)) ? nyC : na, title = "New York")

// ═════════════════════════════════════════════════════════════════════════════
// HTF CANDLES TO THE RIGHT + LABEL POSITIONS
// ═════════════════════════════════════════════════════════════════════════════
var array<box>   miniBoxes = array.new<box>()
var array<line>  miniLines = array.new<line>()
var array<label> miniLbls  = array.new<label>()

f_candle(int x, float o, float h, float l, float c) =>
    if not na(o) and not na(c)
        color col = c >= o ? bullCol : bearCol
        miniLines.push(line.new(x, h, x, l, xloc.bar_index, extend.none, col, line.style_solid, 1))
        miniBoxes.push(box.new(x - 1, math.max(o, c), x + 1, math.min(o, c), border_color = col, bgcolor = col, xloc = xloc.bar_index))

f_miniGroup(Crt s, bool on, int x, float o1, float h1, float l1, float c1, float o2, float h2, float l2, float c2) =>
    int nx = x
    if on
        f_candle(x, o1, h1, l1, c1)
        f_candle(x + 3, o2, h2, l2, c2)
        f_candle(x + 6, s.c3o, s.c3h, s.c3l, close)
        float lo = math.min(nz(l1, low), nz(l2, low), nz(s.c3l, low))
        miniLbls.push(label.new(x + 3, lo, s.lbl, xloc.bar_index, yloc.price, color(na), label.style_label_up, chart.fg_color, size.normal))
        nx := x + 13
    nx

if barstate.islast
    int lblX = time + 2 * chartSec * 1000
    s1.moveLabels(lblX)
    s2.moveLabels(lblX)
    s3.moveLabels(lblX)

    for b in miniBoxes
        b.delete()
    for l in miniLines
        l.delete()
    for b in miniLbls
        b.delete()
    miniBoxes.clear()
    miniLines.clear()
    miniLbls.clear()
    if showMini
        int x = bar_index + miniOff
        x := f_miniGroup(s1, on1, x, a_o1, a_h1, a_l1, a_c1, a_o2, a_h2, a_l2, a_c2)
        x := f_miniGroup(s2, on2, x, b_o1, b_h1, b_l1, b_c1, b_o2, b_h2, b_l2, b_c2)
        x := f_miniGroup(s3, on3, x, c_o1, c_h1, c_l1, c_c1, c_o2, c_h2, c_l2, c_c2)

// ═════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═════════════════════════════════════════════════════════════════════════════
var table dash = table.new(f_pos(dashPos), 4, 4, bgcolor = color.new(#131722, 10), border_color = color.new(#363A45, 0), border_width = 1, frame_color = color.new(#363A45, 0), frame_width = 1)

f_forming(Crt s, bool on, float o2, float h2, float l2, float c2) =>
    string r = ""
    if on and showUnconf and not na(s.c3o)
        [fb, fu] = f_detect(o2, h2, l2, c2, s.c3o, s.c3h, s.c3l, close)
        r := fb ? "Forming ▼" : fu ? "Forming ▲" : "–"
    r

f_row(int row, Crt s, bool enabled, bool on, string forming) =>
    string ts = f_size(dashSize)
    color  sc = s.dir == 1 ? bullCol : s.dir == -1 ? bearCol : #B2B5BE
    if s.done
        sc := color.new(sc, 40)
    string st = not enabled ? "OFF" : not on ? "use chart ≤ " + s.lbl : s.statusText()
    table.cell(dash, 0, row, s.lbl, text_color = color.white, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, row, st, text_color = on ? sc : #787B86, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 2, row, on ? s.keyText() : "", text_color = keyCol, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 3, row, forming, text_color = str.contains(forming, "▲") ? bullCol : str.contains(forming, "▼") ? bearCol : #787B86, text_size = ts)

if barstate.islast and showDash
    string ts = f_size(dashSize)
    table.cell(dash, 0, 0, "CRT", text_color = color.white, text_size = ts)
    table.cell(dash, 1, 0, "Status", text_color = #B2B5BE, text_size = ts)
    table.cell(dash, 2, 0, "Key", text_color = #B2B5BE, text_size = ts)
    table.cell(dash, 3, 0, showUnconf ? "Live" : "", text_color = #B2B5BE, text_size = ts)
    f_row(1, s1, tf1On, on1, f_forming(s1, on1, a_o2, a_h2, a_l2, a_c2))
    f_row(2, s2, tf2On, on2, f_forming(s2, on2, b_o2, b_h2, b_l2, b_c2))
    f_row(3, s3, tf3On, on3, f_forming(s3, on3, c_o2, c_h2, c_l2, c_c2))

// ═════════════════════════════════════════════════════════════════════════════
// STATISTICS TABLE
// ═════════════════════════════════════════════════════════════════════════════
var table stTab = table.new(f_pos(statsPos), 5, 7, bgcolor = color.new(#131722, 10), border_color = color.new(#363A45, 0), border_width = 1, frame_color = color.new(#363A45, 0), frame_width = 1)

f_pct(int a, int n) =>
    n > 0 ? str.tostring(math.round(100.0 * a / n)) + "%" : "–"

f_stRow(int row, string name, int k, bool isTbs) =>
    string ts = f_size(dashSize)
    int    n  = stN.get(k)
    table.cell(stTab, 0, row, name, text_color = color.white, text_size = ts, text_halign = text.align_left)
    table.cell(stTab, 1, row, str.tostring(n), text_color = #B2B5BE, text_size = ts)
    table.cell(stTab, 2, row, f_pct(stT1.get(k), n), text_color = bullCol, text_size = ts)
    table.cell(stTab, 3, row, isTbs ? "–" : f_pct(stT2.get(k), n) + (stMC.get(k) > 0 ? " (MC " + str.tostring(stMC.get(k)) + ")" : ""), text_color = bullCol, text_size = ts)
    table.cell(stTab, 4, row, f_pct(stInv.get(k), n), text_color = bearCol, text_size = ts)

if barstate.islast and showStats
    string ts = f_size(dashSize)
    table.cell(stTab, 0, 0, "Stats", text_color = color.white, text_size = ts)
    table.cell(stTab, 1, 0, "N", text_color = #B2B5BE, text_size = ts)
    table.cell(stTab, 2, 0, "TP1", text_color = #B2B5BE, text_size = ts)
    table.cell(stTab, 3, 0, "TP2", text_color = #B2B5BE, text_size = ts)
    table.cell(stTab, 4, 0, "Stop", text_color = #B2B5BE, text_size = ts)
    f_stRow(1, "Classic", K_CL, false)
    f_stRow(2, "Two Candle", K_2C, false)
    f_stRow(3, "Double Purge", K_DP, false)
    f_stRow(4, "Inside Bar", K_IB, false)
    f_stRow(5, "TBS entry", 0, true)
