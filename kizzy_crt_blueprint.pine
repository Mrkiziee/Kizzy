//
// Kizzy – CRT Blueprint
// Candle Range Theory (CRT) detector across up to 3 higher timeframes.
//
// CRT models
//  1 · Classic CRT        C1 = range. C2 sweeps ONE side of C1 and closes back inside.
//  2 · Two Candle CRT     C2 is an opposite-colour candle with a big body that sweeps one side of C1
//                         (closing inside, or straight through the other side = "delivered").
//  3 · Multiple Candle    Any setup that needs 2+ more HTF candles after the sweep to reach TP2 (tagged "MC").
//  4 · Double Purge CRT   C2 sweeps one side, C3 sweeps the OTHER side, both close inside C1 → trade C3's reversal.
//  5 · Inside Bar CRT     Mother bar + 1..N inside bars, then a candle sweeps the mother bar and closes inside.
//
// Key levels – taken from a HIGHER TF than the CRT candle (top-down, Romeo style).
// The sweep wick must tap one (filter on by default) – shown as 🔑 tags.
//  OHP  Old High Purge     wick takes an older swing high, closes back below it        (bearish)
//  OLP  Old Low Purge      wick takes an older swing low, closes back above it         (bullish)
//  RB   Rejection Block    wick taps the wick zone (body → wick extreme) of an older swing candle
//  OB   Order Block        wick taps the last opposite candle before a displacement
//  FVG  Fair Value Gap     wick taps an open 3-candle imbalance
//  OCL  Open/Close Level   wick taps an older body (open/close) swing level, closes back on the other side
//  IFVG Inverse FVG        wick taps an FVG that price already closed through (polarity flipped)
//
// HTF bias: Bull CRT only when the sweep low is in DISCOUNT of the key-TF range, Bear only in PREMIUM.
//
// Targets: TP1 = 50% of the range, TP2 = opposite side of the range.
// Invalidation: price trades beyond the sweep candle's extreme before TP2.
//
// Alerts: Create Alert → Condition "Kizzy CRT" → "Any alert() function call".

//@version=6
indicator("Kizzy – CRT Blueprint", shorttitle = "Kizzy CRT", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 100)

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═════════════════════════════════════════════════════════════════════════════
const string G_TF  = "Timeframes  (on / TF / line style)"
const string G_TYP = "CRT Types"
const string G_KEY = "Key Levels 🔑"
const string G_FLT = "CRT Filters"
const string G_VIS = "Display"
const string G_ALR = "Alerts"
const string G_SES = "Sessions"
const string G_DSH = "Dashboard"

bool   tf1On  = input.bool(true, "", inline = "1", group = G_TF)
string tf1    = input.timeframe("30", "", inline = "1", group = G_TF)
string tf1Sty = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], inline = "1", group = G_TF)
bool   tf2On  = input.bool(true, "", inline = "2", group = G_TF)
string tf2    = input.timeframe("60", "", inline = "2", group = G_TF)
string tf2Sty = input.string("Dashed", "", ["Solid", "Dashed", "Dotted"], inline = "2", group = G_TF)
bool   tf3On  = input.bool(true, "", inline = "3", group = G_TF)
string tf3    = input.timeframe("240", "", inline = "3", group = G_TF)
string tf3Sty = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], inline = "3", group = G_TF)

bool  useCL  = input.bool(true, "1 · Classic CRT", group = G_TYP,
     tooltip = "C1 = range. C2 sweeps one side of C1 and closes back inside the range.")
bool  use2C  = input.bool(true, "2 · Two Candle CRT", inline = "2c", group = G_TYP,
     tooltip = "C2 has the opposite colour of C1, a body ≥ X% of C1's body, and sweeps one side of C1. If it closes through the other side the range is already delivered (shown as done).")
float c2Body = input.float(60, "min body % of C1", minval = 0, step = 10, inline = "2c", group = G_TYP)
bool  useMC  = input.bool(true, "3 · Multiple Candle CRT (tag)", group = G_TYP,
     tooltip = "A setup that reaches TP2 only after 2+ more HTF candles is tagged MC.")
bool  useDP  = input.bool(true, "4 · Double Purge CRT", group = G_TYP,
     tooltip = "C2 sweeps one side of C1, C3 sweeps the other side; both close back inside C1. Trade the direction of C3's rejection.")
bool  useIB  = input.bool(true, "5 · Inside Bar CRT", inline = "ib", group = G_TYP,
     tooltip = "Mother bar followed by inside bar(s); then a candle sweeps the mother bar's high/low and closes back inside.")
int   maxIB  = input.int(3, "max inside bars", minval = 1, maxval = 5, inline = "ib", group = G_TYP)

bool kOX   = input.bool(true, "OHP / OLP – Old High / Low Purge", group = G_KEY)
bool kRB   = input.bool(true, "RB – Rejection Block", group = G_KEY)
bool kOB   = input.bool(true, "OB – Order Block", group = G_KEY)
bool kFVG  = input.bool(true, "FVG – Fair Value Gap", group = G_KEY)
bool kOCL  = input.bool(true, "OCL – Open / Close Level", group = G_KEY)
bool kIFVG = input.bool(true, "IFVG – Inverse FVG", group = G_KEY)
string keyMode = input.string("One step higher", "Key level TF", ["One step higher", "Same as CRT TF", "Fixed"], inline = "ktf", group = G_KEY,
     tooltip = "Romeo-style top-down: key levels come from a HIGHER timeframe than the CRT candle.\nOne step higher: ≤1H → 4H, 4H → D, D → W, W → M.\nFixed: use the TF on the right for every row.")
string keyFix  = input.timeframe("D", "", inline = "ktf", group = G_KEY)
bool reqKey = input.bool(true, "Only CRTs that tap a key level", group = G_KEY,
     tooltip = "Skip CRTs whose sweep wick did not tap any enabled key level of the key-level TF.")
int  keyLen = input.int(3, "Swing length", minval = 1, maxval = 10, group = G_KEY,
     tooltip = "Bars on each side (on the key-level TF) that confirm a swing high/low for OHP/OLP, RB and OCL.")
int  keyMax = input.int(6, "Levels kept per type", minval = 1, maxval = 20, group = G_KEY)
bool showKey = input.bool(true, "Draw tapped key level", group = G_KEY)

const string G_BIA = "HTF Bias – Premium / Discount"
bool useBias = input.bool(true, "Premium / Discount filter", group = G_BIA,
     tooltip = "Uses the range of the last N closed candles of the key-level TF.\nBull CRT: the sweep low must be in DISCOUNT (below 50%).\nBear CRT: the sweep high must be in PREMIUM (above 50%).")
int  biasN   = input.int(1, "Range = last N key-TF candles", minval = 1, maxval = 20, group = G_BIA)

bool  qualityOnly = input.bool(true, "Quality CRT Only", group = G_FLT,
     tooltip = "The sweep candle must OPEN inside the range: only its wick sweeps the high/low.")
bool  oppColor    = input.bool(false, "Opposite-Color Child Only", group = G_FLT,
     tooltip = "Classic / Inside Bar: range candle and sweep candle must have opposite colours.")
float maxWick     = input.float(100, "Max Wick % (vs Body)", minval = 0, step = 10, group = G_FLT,
     tooltip = "The range candle's total wick length must be ≤ this % of its body (a decisive range candle). 0 = off.")
bool  showTP      = input.bool(true, "Show TP Levels (50%, Target)", group = G_FLT)
bool  showUnconf  = input.bool(true, "Show unconfirmed (forming) CRT in dashboard", group = G_FLT,
     tooltip = "Checks the still-open HTF candle against the last closed one (Classic rule). It can change until that candle closes – no alerts are sent for it.")

color bullCol  = input.color(#089981, "Bull", inline = "c", group = G_VIS)
color bearCol  = input.color(#F23645, "Bear", inline = "c", group = G_VIS)
color lvlCol   = input.color(#787B86, "Range", inline = "c", group = G_VIS)
color keyCol   = input.color(#F5A623, "Key", inline = "c", group = G_VIS)
bool  keepHist = input.bool(false, "Keep past CRTs on chart", group = G_VIS)
bool  showMini = input.bool(true, "Show HTF candles to the right", group = G_VIS)
int   miniOff  = input.int(10, "HTF candles offset (bars)", minval = 4, maxval = 200, group = G_VIS)

bool alNew = input.bool(true, "New CRT", inline = "a", group = G_ALR)
bool alTP1 = input.bool(true, "TP1 hit", inline = "a", group = G_ALR)
bool alTP2 = input.bool(true, "TP2 hit", inline = "a", group = G_ALR)
bool alInv = input.bool(false, "Invalidated", inline = "a", group = G_ALR)

bool   showSes = input.bool(true, "Show sessions (intraday ≤ 1H)", group = G_SES)
string sesTz   = input.string("America/New_York", "Timezone", group = G_SES)
string asiaS   = input.session("2000-0000", "Asia", inline = "s1", group = G_SES)
color  asiaC   = input.color(color.new(#FFB74D, 92), "", inline = "s1", group = G_SES)
string lonS    = input.session("0200-0500", "London", inline = "s2", group = G_SES)
color  lonC    = input.color(color.new(#7E57C2, 92), "", inline = "s2", group = G_SES)
string nyS     = input.session("0930-1130", "New York", inline = "s3", group = G_SES)
color  nyC     = input.color(color.new(#26A69A, 92), "", inline = "s3", group = G_SES)

bool   showDash = input.bool(true, "Show dashboard", group = G_DSH)
string dashPos  = input.string("Bottom Right", "Position", ["Top Right", "Bottom Right", "Bottom Left", "Top Left"], group = G_DSH)
string dashSize = input.string("Small", "Size", ["Tiny", "Small", "Normal"], group = G_DSH)

// ═════════════════════════════════════════════════════════════════════════════
// HELPERS
// ═════════════════════════════════════════════════════════════════════════════
// CRT kinds
const int K_CL = 1
const int K_2C = 2   // two candle, still running
const int K_2D = 3   // two candle, range already delivered by C2
const int K_DP = 4
const int K_IB = 5

f_name(int k) =>
    switch k
        K_CL => "Classic"
        K_2C => "Two Candle"
        K_2D => "Two Candle"
        K_DP => "Double Purge"
        K_IB => "Inside Bar"
        => ""

f_code(int k) =>
    switch k
        K_CL => "CL"
        K_2C => "2C"
        K_2D => "2C"
        K_DP => "DP"
        K_IB => "IB"
        => ""

// Key-level bit mask: 1 OHP/OLP · 2 RB · 4 OB · 8 FVG · 16 OCL · 32 IFVG
f_keyText(int mask, int dir) =>
    string s = ""
    int    m = mask
    array<string> nm = array.from(dir == 1 ? "OLP" : "OHP", "RB", "OB", "FVG", "OCL", "IFVG")
    for n in nm
        if m % 2 == 1
            s := s + (s == "" ? "" : "+") + n
        m := int(math.floor(m / 2))
    s

f_style(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_tfLabel(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec < 3600 ? str.tostring(math.round(sec / 60)) + "m" : sec < 86400 ? str.tostring(math.round(sec / 3600)) + "H" : sec < 604800 ? str.tostring(math.round(sec / 86400)) + "D" : tf

f_px(float x) =>
    str.tostring(x, format.mintick)

f_pos(string p) =>
    switch p
        "Top Right"   => position.top_right
        "Bottom Left" => position.bottom_left
        "Top Left"    => position.top_left
        => position.bottom_right

f_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Normal" => size.normal
        => size.small

// Range candle is "decisive": total wick ≤ maxWick % of body.
f_rangeOk(float o, float h, float l, float c) =>
    float body = math.abs(c - o)
    maxWick <= 0 or (body > 0 and (h - l) - body <= body * maxWick / 100)

// Sweep-and-close-back-inside rule. Range candle (1) vs sweep candle (2). Returns [bearish, bullish].
f_detect(float o1, float h1, float l1, float c1, float o2, float h2, float l2, float c2) =>
    bool sweptH = h2 > h1
    bool sweptL = l2 < l1
    bool inside = c2 < h1 and c2 > l1
    bool bear   = sweptH and not sweptL and inside
    bool bull   = sweptL and not sweptH and inside
    if qualityOnly
        bool openIn = o2 <= h1 and o2 >= l1
        bear := bear and openIn
        bull := bull and openIn
    if oppColor
        bear := bear and c1 > o1 and c2 < o2
        bull := bull and c1 < o1 and c2 > o2
    bool ok = f_rangeOk(o1, h1, l1, c1)
    [bear and ok, bull and ok]

// ─── key-level storage helpers (run on the HTF) ──────────────────────────────
f_push(array<float> a, float v) =>
    a.unshift(v)
    if a.size() > keyMax
        a.pop()

f_pushZ(array<float> t, array<float> b, float top, float bot) =>
    t.unshift(top)
    b.unshift(bot)
    if t.size() > keyMax
        t.pop()
        b.pop()

// level purged by the wick (h / l), close (c) back on the other side
f_lvlBear(array<float> lv, float h, float c) =>
    float r = na
    for v in lv
        if h >= v and c < v
            r := v
            break
    r

f_lvlBull(array<float> lv, float l, float c) =>
    float r = na
    for v in lv
        if l <= v and c > v
            r := v
            break
    r

// wick taps the zone and closes back away from it
f_zoneBear(array<float> t, array<float> b, float h, float c) =>
    float r = na
    for [i, top] in t
        float bot = b.get(i)
        if h >= bot and c < top
            r := bot
            break
    r

f_zoneBull(array<float> t, array<float> b, float l, float c) =>
    float r = na
    for [i, top] in t
        float bot = b.get(i)
        if l <= top and c > bot
            r := top
            break
    r

// remove levels / zones that price CLOSED through
f_dropLvl(array<float> a, bool above) =>
    if a.size() > 0
        for i = a.size() - 1 to 0
            float v = a.get(i)
            if (above and close > v) or (not above and close < v)
                a.remove(i)

f_dropZone(array<float> t, array<float> b, bool above) =>
    if t.size() > 0
        for i = t.size() - 1 to 0
            if (above and close > t.get(i)) or (not above and close < b.get(i))
                t.remove(i)
                b.remove(i)

// FVG closed through → moves to the inverse list
f_invert(array<float> st, array<float> sb, array<float> dt, array<float> db, bool up) =>
    if st.size() > 0
        for i = st.size() - 1 to 0
            float t = st.get(i)
            float b = sb.get(i)
            if (up and close > t) or (not up and close < b)
                st.remove(i)
                sb.remove(i)
                f_pushZ(dt, db, t, b)

f_mask(float v1, float v2, float v3, float v4, float v5, float v6) =>
    int   m   = 0
    float p   = na
    int   bit = 1
    for v in array.from(v1, v2, v3, v4, v5, v6)
        if not na(v)
            m += bit
            if na(p)
                p := v
        bit *= 2
    [m, p]

// All key levels of one timeframe.
type KeyStore
    array<float> pvH    // swing highs           (OHP)
    array<float> pvL    // swing lows            (OLP)
    array<float> ocH    // body swing highs      (OCL)
    array<float> ocL    // body swing lows       (OCL)
    array<float> rbHT   // rejection block above: wick high
    array<float> rbHB   //                        body top
    array<float> rbLT   // rejection block below: body bottom
    array<float> rbLB   //                        wick low
    array<float> obBT   // bullish OB (support)
    array<float> obBB
    array<float> obST   // bearish OB (resistance)
    array<float> obSB
    array<float> fvBT   // bullish FVG (support)
    array<float> fvBB
    array<float> fvST   // bearish FVG (resistance)
    array<float> fvSB
    array<float> ifBT   // inverse FVG acting as support
    array<float> ifBB
    array<float> ifST   // inverse FVG acting as resistance
    array<float> ifSB

f_newStore() =>
    KeyStore.new(array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(),
         array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(),
         array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(),
         array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>(), array.new<float>())

method snapshot(KeyStore k) =>
    KeyStore.new(k.pvH.copy(), k.pvL.copy(), k.ocH.copy(), k.ocL.copy(), k.rbHT.copy(),
         k.rbHB.copy(), k.rbLT.copy(), k.rbLB.copy(), k.obBT.copy(), k.obBB.copy(),
         k.obST.copy(), k.obSB.copy(), k.fvBT.copy(), k.fvBB.copy(), k.fvST.copy(),
         k.fvSB.copy(), k.ifBT.copy(), k.ifBB.copy(), k.ifST.copy(), k.ifSB.copy())

// Runs ON THE KEY-LEVEL TF: updates the store with the current bar.
method update(KeyStore k) =>
    float ph  = ta.pivothigh(high, keyLen, keyLen)
    float pl  = ta.pivotlow(low, keyLen, keyLen)
    float bph = ta.pivothigh(math.max(open, close), keyLen, keyLen)
    float bpl = ta.pivotlow(math.min(open, close), keyLen, keyLen)

    f_dropLvl(k.pvH, true)
    f_dropLvl(k.pvL, false)
    f_dropLvl(k.ocH, true)
    f_dropLvl(k.ocL, false)
    f_dropZone(k.rbHT, k.rbHB, true)
    f_dropZone(k.rbLT, k.rbLB, false)
    f_dropZone(k.obST, k.obSB, true)
    f_dropZone(k.obBT, k.obBB, false)
    f_dropZone(k.ifST, k.ifSB, true)
    f_dropZone(k.ifBT, k.ifBB, false)
    f_invert(k.fvBT, k.fvBB, k.ifST, k.ifSB, false)   // bullish FVG closed below → resistance IFVG
    f_invert(k.fvST, k.fvSB, k.ifBT, k.ifBB, true)    // bearish FVG closed above → support IFVG

    if not na(ph)
        f_push(k.pvH, ph)
        f_pushZ(k.rbHT, k.rbHB, ph, math.max(open[keyLen], close[keyLen]))
    if not na(pl)
        f_push(k.pvL, pl)
        f_pushZ(k.rbLT, k.rbLB, math.min(open[keyLen], close[keyLen]), pl)
    if not na(bph)
        f_push(k.ocH, bph)
    if not na(bpl)
        f_push(k.ocL, bpl)
    if low > high[2]
        f_pushZ(k.fvBT, k.fvBB, low, high[2])
    if high < low[2]
        f_pushZ(k.fvST, k.fvSB, low[2], high)
    if close[1] < open[1] and close > high[1]
        f_pushZ(k.obBT, k.obBB, high[1], low[1])
    if close[1] > open[1] and close < low[1]
        f_pushZ(k.obST, k.obSB, high[1], low[1])

// request.security payload: the store as of the last closed key-TF bar ([1]) and the one before ([2]),
// the close time of the last closed key-TF bar, and the premium/discount range of the last N closed bars.
f_keyTF_data() =>
    var KeyStore ks = f_newStore()
    ks.update()
    KeyStore snap = ks.snapshot()
    [snap[1], snap[2], time_close[1], ta.highest(high, biasN)[1], ta.lowest(low, biasN)[1]]

// Tests a sweep candle (h, l, c) against a key store. Returns [bitMask, firstLevelPrice].
f_keyCheck(KeyStore k, int dir, float h, float l, float c) =>
    int   mask = 0
    float px   = na
    if not na(k)
        if dir == -1
            [m, p] = f_mask(kOX ? f_lvlBear(k.pvH, h, c) : na, kRB ? f_zoneBear(k.rbHT, k.rbHB, h, c) : na,
                 kOB ? f_zoneBear(k.obST, k.obSB, h, c) : na, kFVG ? f_zoneBear(k.fvST, k.fvSB, h, c) : na,
                 kOCL ? f_lvlBear(k.ocH, h, c) : na, kIFVG ? f_zoneBear(k.ifST, k.ifSB, h, c) : na)
            mask := m
            px   := p
        else if dir == 1
            [m, p] = f_mask(kOX ? f_lvlBull(k.pvL, l, c) : na, kRB ? f_zoneBull(k.rbLT, k.rbLB, l, c) : na,
                 kOB ? f_zoneBull(k.obBT, k.obBB, l, c) : na, kFVG ? f_zoneBull(k.fvBT, k.fvBB, l, c) : na,
                 kOCL ? f_lvlBull(k.ocL, l, c) : na, kIFVG ? f_zoneBull(k.ifBT, k.ifBB, l, c) : na)
            mask := m
            px   := p
    [mask, px]

// Key-level TF for a CRT TF
f_keyTF(string tf) =>
    int s = timeframe.in_seconds(tf)
    string nxt = s <= 3600 ? "240" : s <= 14400 ? "D" : s <= 86400 ? "W" : "M"
    keyMode == "Same as CRT TF" ? tf : keyMode == "Fixed" ? keyFix : nxt

// Runs ON THE HIGHER TIMEFRAME. The current HTF bar is the candidate sweep candle.
// Returns [kind, dir, rangeHigh, rangeLow, invalidation, rangeTime].
f_classify() =>
    int   kind = 0
    int   dir  = 0
    float rh   = na
    float rl   = na
    float iv   = na
    int   tr   = na

    // 4 · Double Purge – range = [2], [1] purges one side, current bar purges the other side
    if useDP
        float h0   = high[2]
        float l0   = low[2]
        bool  c1In = close[1] < h0 and close[1] > l0
        bool  c0In = close < h0 and close > l0
        bool  p1Hi = high[1] > h0 and low[1] >= l0 and c1In
        bool  p1Lo = low[1] < l0 and high[1] <= h0 and c1In
        bool  p0Hi = high > h0 and low >= l0 and c0In
        bool  p0Lo = low < l0 and high <= h0 and c0In
        if f_rangeOk(open[2], h0, l0, close[2]) and ((p1Hi and p0Lo) or (p1Lo and p0Hi))
            kind := K_DP
            dir  := p0Lo ? 1 : -1
            rh   := h0
            rl   := l0
            iv   := p0Lo ? low : high
            tr   := time[2]

    // 5 · Inside Bar – mother bar [k] with bars [1..k-1] inside it, current bar sweeps the mother
    if kind == 0 and useIB
        for k = 2 to maxIB + 1
            float mh    = high[k]
            float ml    = low[k]
            bool  allIn = true
            for j = 1 to k - 1
                if high[j] > mh or low[j] < ml
                    allIn := false
                    break
            if allIn
                [bear, bull] = f_detect(open[k], mh, ml, close[k], open, high, low, close)
                if bear or bull
                    kind := K_IB
                    dir  := bull ? 1 : -1
                    rh   := mh
                    rl   := ml
                    iv   := bull ? low : high
                    tr   := time[k]
                break

    // 2 · Two Candle – opposite colour, big body, sweeps one side of [1]
    if kind == 0 and use2C
        float h1     = high[1]
        float l1     = low[1]
        float b1     = math.abs(close[1] - open[1])
        bool  opp    = (close[1] > open[1] and close < open) or (close[1] < open[1] and close > open)
        bool  bigB   = math.abs(close - open) >= b1 * c2Body / 100
        bool  openIn = not qualityOnly or (open <= h1 and open >= l1)
        bool  bear   = high > h1 and close < open and close < h1
        bool  bull   = low < l1 and close > open and close > l1
        if opp and bigB and openIn and f_rangeOk(open[1], h1, l1, close[1]) and (bull or bear)
            bool delivered = bull ? close > h1 : close < l1
            kind := delivered ? K_2D : K_2C
            dir  := bull ? 1 : -1
            rh   := h1
            rl   := l1
            iv   := bull ? low : high
            tr   := time[1]

    // 1 · Classic – range = [1]
    if kind == 0 and useCL
        [bear, bull] = f_detect(open[1], high[1], low[1], close[1], open, high, low, close)
        if bear or bull
            kind := K_CL
            dir  := bull ? 1 : -1
            rh   := high[1]
            rl   := low[1]
            iv   := bull ? low : high
            tr   := time[1]

    [kind, dir, rh, rl, iv, tr]

// Classification of the last CLOSED HTF candle (non-repainting: [1] + lookahead_on).
f_htf() =>
    [k, d, rh, rl, iv, tr] = f_classify()
    [k[1], d[1], rh[1], rl[1], iv[1], tr[1]]

// Last two CLOSED HTF candles, for the mini candles and the live check.
f_pair() =>
    [open[2], high[2], low[2], close[2], open[1], high[1], low[1], close[1], time[1]]

// ═════════════════════════════════════════════════════════════════════════════
// CRT STATE
// ═════════════════════════════════════════════════════════════════════════════
type Crt
    string tf
    string lbl
    string sty
    string klbl            // key-level TF label
    int    kind    = 0
    int    dir     = 0
    float  crh
    float  crl
    float  tp1
    float  tp2
    float  inval
    int    keyMask = 0
    float  keyPx
    string pd      = ""    // "Disc" / "Prem" of the sweep inside the key-TF range
    bool   tp1Hit  = false
    bool   done    = false
    int    result  = 0     // 1 = TP2 reached, -1 = invalidated
    int    age     = 0     // HTF candles since confirmation
    bool   multi   = false
    float  c3o
    float  c3h
    float  c3l
    line   lH
    line   lL
    line   lT
    line   lK
    label  bH
    label  bL
    label  bT
    label  bK

method clearDraw(Crt s) =>
    line.delete(s.lH)
    line.delete(s.lL)
    line.delete(s.lT)
    line.delete(s.lK)
    label.delete(s.bH)
    label.delete(s.bL)
    label.delete(s.bT)
    label.delete(s.bK)

method freeze(Crt s) =>
    for l in array.from(s.lH, s.lL, s.lT, s.lK)
        if not na(l)
            l.set_extend(extend.none)
            l.set_x2(time)

method keyText(Crt s) =>
    string k = s.keyMask > 0 ? "🔑 " + f_keyText(s.keyMask, s.dir) + " " + s.klbl : ""
    s.dir == 0 ? "" : k + (s.pd != "" ? (k != "" ? " · " : "") + s.pd : "")

method statusText(Crt s) =>
    string base = f_name(s.kind) + (s.dir == 1 ? " ▲" : " ▼")
    string r = ""
    if s.dir == 0
        r := "Waiting"
    else if s.result == 1
        r := base + (s.multi ? " · MC" : "") + " · TP2 ✓"
    else if s.result == -1
        r := base + (s.tp1Hit ? " · TP1 ✓ / stop" : " · ✗")
    else
        r := base + (s.tp1Hit ? " · TP1 ✓" : "") + (s.age > 0 ? " · +" + str.tostring(s.age) : "")
    r

method start(Crt s, int kind, int dir, float rh, float rl, float iv, int tr, int km, float kp) =>
    if keepHist
        s.freeze()
    else
        s.clearDraw()
    s.kind    := kind
    s.dir     := dir
    s.crh     := rh
    s.crl     := rl
    s.tp1     := (rh + rl) / 2
    s.tp2     := dir == -1 ? rl : rh
    s.inval   := iv
    s.keyMask := km
    s.keyPx   := kp
    s.tp1Hit  := false
    s.done    := false
    s.result  := 0
    s.age     := 0
    s.multi   := false
    s.lK      := na
    s.bK      := na
    string st  = f_style(s.sty)
    color  dc  = dir == 1 ? bullCol : bearCol
    string tag = " " + f_code(kind)
    string hTxt = "CRH " + s.lbl + (dir == -1 ? " ▼" + tag : "") + (showTP and dir == 1 ? " | TP2" : "")
    string lTxt = "CRL " + s.lbl + (dir == 1 ? " ▲" + tag : "") + (showTP and dir == -1 ? " | TP2" : "")
    s.lH := line.new(tr, rh, time, rh, xloc.bar_time, extend.right, dir == -1 ? dc : lvlCol, st, 1)
    s.lL := line.new(tr, rl, time, rl, xloc.bar_time, extend.right, dir == 1 ? dc : lvlCol, st, 1)
    s.bH := label.new(time, rh, hTxt, xloc.bar_time, yloc.price, color(na), label.style_label_left, dir == -1 ? dc : lvlCol, size.small)
    s.bL := label.new(time, rl, lTxt, xloc.bar_time, yloc.price, color(na), label.style_label_left, dir == 1 ? dc : lvlCol, size.small)
    if showTP
        s.lT := line.new(tr, s.tp1, time, s.tp1, xloc.bar_time, extend.right, color.new(dc, 30), line.style_dashed, 1)
        s.bT := label.new(time, s.tp1, "TP1 " + s.lbl + " (50%)", xloc.bar_time, yloc.price, color(na), label.style_label_left, dc, size.small)
    if showKey and km > 0 and not na(kp)
        s.lK := line.new(tr, kp, time, kp, xloc.bar_time, extend.right, keyCol, line.style_dotted, 1)
        s.bK := label.new(time, kp, f_keyText(km, dir) + " 🔑 " + s.klbl, xloc.bar_time, yloc.price, color(na), label.style_label_left, keyCol, size.small)
    // Two Candle (delivered): C2 already ran through the whole range
    if kind == K_2D
        s.tp1Hit := true
        s.done   := true
        s.result := 1
        s.freeze()

// Follows an active CRT on every chart bar. Returns [tp1Hit, tp2Hit, invalidated] events.
method track(Crt s) =>
    bool e1 = false
    bool e2 = false
    bool ei = false
    if s.dir != 0 and not s.done
        bool hitTp1 = s.dir == -1 ? low <= s.tp1 : high >= s.tp1
        bool hitTp2 = s.dir == -1 ? low <= s.tp2 : high >= s.tp2
        bool broke  = s.dir == -1 ? high > s.inval : low < s.inval
        if not s.tp1Hit and hitTp1
            s.tp1Hit := true
            e1 := true
            if not na(s.bT)
                s.bT.set_text("TP1 " + s.lbl + " ✓")
        if hitTp2
            s.done   := true
            s.result := 1
            s.multi  := useMC and s.age >= 1
            e2 := true
        else if broke
            s.done   := true
            s.result := -1
            ei := true
        if s.done
            s.freeze()
    [e1, e2, ei]

method moveLabels(Crt s, int x) =>
    if s.dir != 0 and not s.done
        for b in array.from(s.bH, s.bL, s.bT, s.bK)
            if not na(b)
                b.set_x(x)

// One timeframe, one chart bar. `tf` is passed separately so it stays a simple string.
// k1/k2 = key store as of the last / previous closed key-TF bar, kClose = close time of that bar,
// bh/bl = premium-discount range, sh/sl/sc/st = sweep candle high/low/close/open time.
f_step(Crt s, string tf, bool on, int kind, int dir, float rh, float rl, float iv, int tr,
     KeyStore k1, KeyStore k2, int kClose, float bh, float bl, float sh, float sl, float sc, int st) =>
    bool newHtf = timeframe.change(tf)
    // live (still open) HTF candle, built from chart bars
    if newHtf or na(s.c3o)
        s.c3o := open
        s.c3h := high
        s.c3l := low
    else
        s.c3h := math.max(s.c3h, high)
        s.c3l := math.min(s.c3l, low)
    if newHtf and s.dir != 0 and not s.done
        s.age += 1
    bool nBull = false
    bool nBear = false
    if on and newHtf and kind != 0 and not na(rh)
        // only key levels that existed BEFORE the sweep candle opened
        KeyStore ks = not na(kClose) and kClose > st ? k2 : k1
        [km, kp] = f_keyCheck(ks, dir, sh, sl, sc)
        float eq    = (bh + bl) / 2
        float tip   = dir == 1 ? sl : sh
        bool  pdOk  = not useBias or na(eq) or (dir == 1 ? tip <= eq : tip >= eq)
        bool  keyOk = not reqKey or km > 0
        if pdOk and keyOk
            s.start(kind, dir, rh, rl, iv, tr, km, kp)
            s.pd  := na(eq) ? "" : tip < eq ? "Disc" : "Prem"
            nBull := dir == 1
            nBear := dir == -1
    [e1, e2, ei] = s.track()
    [nBull, nBear, e1, e2, ei]

f_alert(Crt s, bool nBull, bool nBear, bool e1, bool e2, bool ei) =>
    string sym = syminfo.ticker
    string nm  = f_name(s.kind)
    string dr  = s.dir == 1 ? "BULL" : "BEAR"
    string ky  = s.keyMask > 0 ? " | Key: " + f_keyText(s.keyMask, s.dir) : ""
    if alNew and (nBull or nBear)
        string extra = s.kind == K_2D ? " | range already delivered" : str.format(" | TP1 (50%): {0} | TP2: {1} | Invalid: {2}", f_px(s.tp1), f_px(s.tp2), f_px(s.inval))
        alert(str.format("{0} | {1} CRT {2} {3}{4}{5}", sym, s.lbl, nm, nBull ? "BULL 🟢" : "BEAR 🔴", ky, extra), alert.freq_once_per_bar)
    if alTP1 and e1
        alert(str.format("{0} | {1} {2} CRT {3} | TP1 hit ✓ {4}", sym, s.lbl, nm, dr, f_px(s.tp1)), alert.freq_once_per_bar)
    if alTP2 and e2
        alert(str.format("{0} | {1} {2} CRT {3}{4} | TP2 hit ✓ {5}", sym, s.lbl, nm, dr, s.multi ? " (Multiple Candle)" : "", f_px(s.tp2)), alert.freq_once_per_bar)
    if alInv and ei
        alert(str.format("{0} | {1} {2} CRT {3} | invalidated beyond {4}", sym, s.lbl, nm, dr, f_px(s.inval)), alert.freq_once_per_bar)

// ═════════════════════════════════════════════════════════════════════════════
// DATA + ENGINE
// ═════════════════════════════════════════════════════════════════════════════
int chartSec = timeframe.in_seconds(timeframe.period)
bool on1 = tf1On and timeframe.in_seconds(tf1) >= chartSec
bool on2 = tf2On and timeframe.in_seconds(tf2) >= chartSec
bool on3 = tf3On and timeframe.in_seconds(tf3) >= chartSec

[a_k, a_d, a_rh, a_rl, a_iv, a_tr] = request.security(syminfo.tickerid, tf1, f_htf(), lookahead = barmerge.lookahead_on)
[b_k, b_d, b_rh, b_rl, b_iv, b_tr] = request.security(syminfo.tickerid, tf2, f_htf(), lookahead = barmerge.lookahead_on)
[c_k, c_d, c_rh, c_rl, c_iv, c_tr] = request.security(syminfo.tickerid, tf3, f_htf(), lookahead = barmerge.lookahead_on)

[a_o1, a_h1, a_l1, a_c1, a_o2, a_h2, a_l2, a_c2, a_t2] = request.security(syminfo.tickerid, tf1, f_pair(), lookahead = barmerge.lookahead_on)
[a_ks1, a_ks2, a_kct, a_bh, a_bl] = request.security(syminfo.tickerid, f_keyTF(tf1), f_keyTF_data(), lookahead = barmerge.lookahead_on)
[b_o1, b_h1, b_l1, b_c1, b_o2, b_h2, b_l2, b_c2, b_t2] = request.security(syminfo.tickerid, tf2, f_pair(), lookahead = barmerge.lookahead_on)
[b_ks1, b_ks2, b_kct, b_bh, b_bl] = request.security(syminfo.tickerid, f_keyTF(tf2), f_keyTF_data(), lookahead = barmerge.lookahead_on)
[c_o1, c_h1, c_l1, c_c1, c_o2, c_h2, c_l2, c_c2, c_t2] = request.security(syminfo.tickerid, tf3, f_pair(), lookahead = barmerge.lookahead_on)
[c_ks1, c_ks2, c_kct, c_bh, c_bl] = request.security(syminfo.tickerid, f_keyTF(tf3), f_keyTF_data(), lookahead = barmerge.lookahead_on)

var Crt s1 = Crt.new(tf1, f_tfLabel(tf1), tf1Sty, f_tfLabel(f_keyTF(tf1)))
var Crt s2 = Crt.new(tf2, f_tfLabel(tf2), tf2Sty, f_tfLabel(f_keyTF(tf2)))
var Crt s3 = Crt.new(tf3, f_tfLabel(tf3), tf3Sty, f_tfLabel(f_keyTF(tf3)))

[n1u, n1d, e11, e12, e1i] = f_step(s1, tf1, on1, a_k, a_d, a_rh, a_rl, a_iv, a_tr, a_ks1, a_ks2, a_kct, a_bh, a_bl, a_h2, a_l2, a_c2, a_t2)
[n2u, n2d, e21, e22, e2i] = f_step(s2, tf2, on2, b_k, b_d, b_rh, b_rl, b_iv, b_tr, b_ks1, b_ks2, b_kct, b_bh, b_bl, b_h2, b_l2, b_c2, b_t2)
[n3u, n3d, e31, e32, e3i] = f_step(s3, tf3, on3, c_k, c_d, c_rh, c_rl, c_iv, c_tr, c_ks1, c_ks2, c_kct, c_bh, c_bl, c_h2, c_l2, c_c2, c_t2)

f_alert(s1, n1u, n1d, e11, e12, e1i)
f_alert(s2, n2u, n2d, e21, e22, e2i)
f_alert(s3, n3u, n3d, e31, e32, e3i)

// Small markers on the bar where a CRT is confirmed
bool anyBull = n1u or n2u or n3u
bool anyBear = n1d or n2d or n3d
plotshape(anyBull, "Bull CRT", shape.triangleup, location.belowbar, bullCol, size = size.tiny)
plotshape(anyBear, "Bear CRT", shape.triangledown, location.abovebar, bearCol, size = size.tiny)

// ═════════════════════════════════════════════════════════════════════════════
// SESSIONS
// ═════════════════════════════════════════════════════════════════════════════
bool sesOk = showSes and timeframe.isintraday and chartSec <= 3600
bgcolor(sesOk and not na(time(timeframe.period, asiaS, sesTz)) ? asiaC : na, title = "Asia")
bgcolor(sesOk and not na(time(timeframe.period, lonS, sesTz)) ? lonC : na, title = "London")
bgcolor(sesOk and not na(time(timeframe.period, nyS, sesTz)) ? nyC : na, title = "New York")

// ═════════════════════════════════════════════════════════════════════════════
// HTF CANDLES TO THE RIGHT + LABEL POSITIONS
// ═════════════════════════════════════════════════════════════════════════════
var array<box>   miniBoxes = array.new<box>()
var array<line>  miniLines = array.new<line>()
var array<label> miniLbls  = array.new<label>()

f_candle(int x, float o, float h, float l, float c) =>
    if not na(o) and not na(c)
        color col = c >= o ? bullCol : bearCol
        miniLines.push(line.new(x, h, x, l, xloc.bar_index, extend.none, col, line.style_solid, 1))
        miniBoxes.push(box.new(x - 1, math.max(o, c), x + 1, math.min(o, c), border_color = col, bgcolor = col, xloc = xloc.bar_index))

f_miniGroup(Crt s, bool on, int x, float o1, float h1, float l1, float c1, float o2, float h2, float l2, float c2) =>
    int nx = x
    if on
        f_candle(x, o1, h1, l1, c1)
        f_candle(x + 3, o2, h2, l2, c2)
        f_candle(x + 6, s.c3o, s.c3h, s.c3l, close)
        float lo = math.min(nz(l1, low), nz(l2, low), nz(s.c3l, low))
        miniLbls.push(label.new(x + 3, lo, s.lbl, xloc.bar_index, yloc.price, color(na), label.style_label_up, chart.fg_color, size.normal))
        nx := x + 13
    nx

if barstate.islast
    int lblX = time + 2 * chartSec * 1000
    s1.moveLabels(lblX)
    s2.moveLabels(lblX)
    s3.moveLabels(lblX)

    for b in miniBoxes
        b.delete()
    for l in miniLines
        l.delete()
    for b in miniLbls
        b.delete()
    miniBoxes.clear()
    miniLines.clear()
    miniLbls.clear()
    if showMini
        int x = bar_index + miniOff
        x := f_miniGroup(s1, on1, x, a_o1, a_h1, a_l1, a_c1, a_o2, a_h2, a_l2, a_c2)
        x := f_miniGroup(s2, on2, x, b_o1, b_h1, b_l1, b_c1, b_o2, b_h2, b_l2, b_c2)
        x := f_miniGroup(s3, on3, x, c_o1, c_h1, c_l1, c_c1, c_o2, c_h2, c_l2, c_c2)

// ═════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═════════════════════════════════════════════════════════════════════════════
var table dash = table.new(f_pos(dashPos), 4, 4, bgcolor = color.new(#131722, 10), border_color = color.new(#363A45, 0), border_width = 1, frame_color = color.new(#363A45, 0), frame_width = 1)

f_forming(Crt s, bool on, float o2, float h2, float l2, float c2) =>
    string r = ""
    if on and showUnconf and not na(s.c3o)
        [fb, fu] = f_detect(o2, h2, l2, c2, s.c3o, s.c3h, s.c3l, close)
        r := fb ? "Forming ▼" : fu ? "Forming ▲" : "–"
    r

f_row(int row, Crt s, bool enabled, bool on, string forming) =>
    string ts = f_size(dashSize)
    color  sc = s.dir == 1 ? bullCol : s.dir == -1 ? bearCol : #B2B5BE
    if s.done
        sc := color.new(sc, 40)
    string st = not enabled ? "OFF" : not on ? "TF < chart" : s.statusText()
    table.cell(dash, 0, row, s.lbl, text_color = color.white, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, row, st, text_color = on ? sc : #787B86, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 2, row, on ? s.keyText() : "", text_color = keyCol, text_size = ts, text_halign = text.align_left)
    table.cell(dash, 3, row, forming, text_color = str.contains(forming, "▲") ? bullCol : str.contains(forming, "▼") ? bearCol : #787B86, text_size = ts)

if barstate.islast and showDash
    string ts = f_size(dashSize)
    table.cell(dash, 0, 0, "CRT", text_color = color.white, text_size = ts)
    table.cell(dash, 1, 0, "Status", text_color = #B2B5BE, text_size = ts)
    table.cell(dash, 2, 0, "Key", text_color = #B2B5BE, text_size = ts)
    table.cell(dash, 3, 0, showUnconf ? "Live" : "", text_color = #B2B5BE, text_size = ts)
    f_row(1, s1, tf1On, on1, f_forming(s1, on1, a_o2, a_h2, a_l2, a_c2))
    f_row(2, s2, tf2On, on2, f_forming(s2, on2, b_o2, b_h2, b_l2, b_c2))
    f_row(3, s3, tf3On, on3, f_forming(s3, on3, c_o2, c_h2, c_l2, c_c2))
