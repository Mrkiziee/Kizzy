bool  useIB  = input.bool(true, "5 · Inside Bar CRT", inline = "ib", group = G_TYP,
     tooltip = "Mother bar followed by inside bar(s); then a candle sweeps the mother bar's high/low and closes back inside.")
int   maxIB  = input.int(3, "max inside bars", minval = 1, maxval = 5, inline = "ib", group = G_TYP)

bool kOX   = input.bool(true, "OHP / OLP – Old High / Low Purge", group = G_KEY)
