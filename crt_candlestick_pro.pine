//@version=5
indicator("CRT Candlestick (Pro Custom - M30 Enhanced)", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count = 500)

// ==========================================
// 1. การตั้งค่า ICT AMD Sessions
// ==========================================
var g_AMD = "ตั้งค่า ICT AMD (เวลาไทย UTC+7)"
show_amd    = input.bool(true, "แสดงช่วงเวลา AMD", group=g_AMD)
asia_time   = input.session("0700-1200", "ช่วงสะสมราคา (A)", group=g_AMD)
london_time = input.session("1400-1700", "ช่วงหลอกล่อ (M)", group=g_AMD)
ny_time     = input.session("1900-2200", "ช่วงกระจายราคา (D)", group=g_AMD)

color_acc   = input.color(color.new(#1E90FF, 92), "สีช่วงสะสม (A)", group=g_AMD)
color_man   = input.color(color.new(#FF4500, 92), "สีช่วงหลอกล่อ (M)", group=g_AMD)
color_dis   = input.color(color.new(#00FA9A, 92), "สีช่วงกระจายราคา (D)", group=g_AMD)
// [แก้] สีดำมองไม่เห็นบนกราฟธีมมืด → เปลี่ยนค่าเริ่มต้นเป็นสีเทาอ่อน
amd_txt_col = input.color(color.new(#B2B5BE, 10), "สีตัวอักษร A/M/D", group=g_AMD)

render_amd_box(sess, _color, _label) =>
    var box b = na
    var label l = na
    in_sess = not na(time(timeframe.period, sess, "UTC+7"))
    new_sess = in_sess and not in_sess[1]

    if new_sess
        b := box.new(bar_index, high, bar_index, low, bgcolor=_color, border_color=color.new(color.white, 100))
        l := label.new(bar_index, high, _label, color=color.new(color.white, 100), textcolor=amd_txt_col, style=label.style_none, size=size.small)
    else if in_sess and not na(b)
        box.set_right(b, bar_index)
        box.set_top(b, math.max(box.get_top(b), high))
        box.set_bottom(b, math.min(box.get_bottom(b), low))
        label.set_x(l, math.round((box.get_left(b) + bar_index) / 2))
        label.set_y(l, box.get_top(b))

if show_amd
    render_amd_box(asia_time, color_acc, "A")
    render_amd_box(london_time, color_man, "M")
    render_amd_box(ny_time, color_dis, "D")

// ==========================================
// 2. การตั้งค่าเส้นระดับราคา Multi-Timeframe (M30 - W1)
// ==========================================
var g_TF = "ตั้งค่า Timeframes"
use_tf_m30      = input.bool(true, "แสดงเส้น 30 นาที", inline = "TF0", group = g_TF)
tf_m30          = input.timeframe("30", "", inline = "TF0", group = g_TF)
tf_m30_color    = input.color(#808080, "", inline = "TF0", group = g_TF)
use_tf_m30_mid  = input.bool(true, "แสดงระดับ 50% M30", inline = "TF0M", group = g_TF)

use_tf_h1       = input.bool(true, "แสดงเส้น 1 ชั่วโมง", inline = "TF1", group = g_TF)
tf_h1           = input.timeframe("60", "", inline = "TF1", group = g_TF)
tf_h1_color     = input.color(#FF0000, "", inline = "TF1", group = g_TF)
use_tf_h1_mid   = input.bool(true, "แสดงระดับ 50% H1", inline = "TF1M", group = g_TF)

use_tf_h4       = input.bool(true, "แสดงเส้น 4 ชั่วโมง", inline = "TF2", group = g_TF)
tf_h4           = input.timeframe("240", "", inline = "TF2", group = g_TF)
tf_h4_color     = input.color(#1E90FF, "", inline = "TF2", group = g_TF)
use_tf_h4_mid   = input.bool(true, "แสดงระดับ 50% H4", inline = "TF2M", group = g_TF)

use_tf_d        = input.bool(true, "แสดงเส้น รายวัน", inline = "TF3", group = g_TF)
tf_d            = input.timeframe("D", "", inline = "TF3", group = g_TF)
tf_d_color      = input.color(#FF69B4, "", inline = "TF3", group = g_TF)
use_tf_d_mid    = input.bool(true, "แสดงระดับ 50% D", inline = "TF3M", group = g_TF)

use_tf_w        = input.bool(true, "แสดงเส้น รายสัปดาห์", inline = "TF4", group = g_TF)
tf_w            = input.timeframe("W", "", inline = "TF4", group = g_TF)
tf_w_color      = input.color(#32CD32, "", inline = "TF4", group = g_TF)
use_tf_w_mid    = input.bool(true, "แสดงระดับ 50% W", inline = "TF4M", group = g_TF)

var g_OPT = "ตัวเลือกการแสดงผลเส้น"
minbars         = input.int(1, "จำนวนแท่งเทียนขั้นต่ำ", group = g_OPT)
maxbars         = input.int(250, "จำนวนแท่งเทียนสูงสุด", group = g_OPT)
hllinewidth     = input.int(1, "ความหนาเส้น High/Low", group = g_OPT)
midlinewidth    = input.int(1, "ความหนาเส้น 50%", group = g_OPT)

var g_EOL = "ตัวเลือกชื่อระดับราคา (ท้ายเส้น)"
show_eol_labels  = input.bool(true, "แสดงชื่อระดับราคา", group = g_EOL)
eol_label_offset = input.int(5, "ระยะห่างชื่อ (Offset)", minval=1, maxval=50, group = g_EOL)

process_tf(tf) =>
    var float rangeHigh = na
    var float rangeLow = na
    var int rangeStart = 0
    var bool inConsolidation = true
    // [แก้] เดิมใช้ open/high/low/close + lookahead_on โดยไม่เลื่อน [1] → บนแท่งย้อนหลังจะ "รู้" high/low
    // ของแท่ง TF ใหญ่ล่วงหน้าตั้งแต่แท่งแรก (repaint / มองอนาคต) ตอนนี้ใช้แท่ง TF ใหญ่ที่ "ปิดแล้ว" เท่านั้น
    [tfOpen, tfHigh, tfLow, tfClose, tfTime] = request.security(syminfo.tickerid, tf, [open[1], high[1], low[1], close[1], time], barmerge.gaps_off, barmerge.lookahead_on)
    newBar = ta.change(tfTime) != 0
    tfChildUp = tfOpen > tfClose ? tfOpen : tfClose
    tfChildDown = tfOpen > tfClose ? tfClose : tfOpen
    if newBar
        upControl = tfChildUp > rangeHigh and bar_index - rangeStart > minbars and bar_index - rangeStart <= maxbars
        downControl = tfChildDown < rangeLow and bar_index - rangeStart > minbars and bar_index - rangeStart <= maxbars
        if (upControl or downControl)
            inConsolidation := false
        if (inConsolidation and tfChildDown <= rangeHigh and tfChildDown >= rangeLow and tfChildUp <= rangeHigh and tfChildUp >= rangeLow and bar_index > 1)
            rangeStart := rangeStart
        else
            rangeHigh := tfHigh
            rangeLow := tfLow
            rangeStart := bar_index
            inConsolidation := true
    [rangeHigh, rangeLow, (rangeHigh + rangeLow) / 2, rangeStart, inConsolidation, newBar]

plot_lines(tfColor, _high, _low, mid, start, inRange, newBar, useMid, tfName) =>
    var line highLine = na
    var line lowLine = na
    var line midLine = na
    var label hLabel = na
    var label lLabel = na
    var label mLabel = na
    if newBar and inRange
        line.delete(highLine), line.delete(lowLine), line.delete(midLine)
        label.delete(hLabel), label.delete(lLabel), label.delete(mLabel)
        validStart = math.max(start, 0)
        highLine := line.new(validStart, _high, bar_index, _high, color=color.new(tfColor, 30), width=hllinewidth)
        lowLine  := line.new(validStart, _low, bar_index, _low, color=color.new(tfColor, 30), width=hllinewidth)
        if useMid
            midLine := line.new(validStart, mid, bar_index, mid, color=color.new(tfColor, 50), width=midlinewidth, style=line.style_dashed)
            if show_eol_labels
                mLabel := label.new(bar_index + eol_label_offset, mid, text=tfName + " 50%", color=color.new(color.white, 100), textcolor=color.new(tfColor, 0), style=label.style_none, size=size.tiny)
        if show_eol_labels
            hLabel := label.new(bar_index + eol_label_offset, _high, text=tfName + " H", color=color.new(color.white, 100), textcolor=color.new(tfColor, 0), style=label.style_none, size=size.tiny)
            lLabel := label.new(bar_index + eol_label_offset, _low, text=tfName + " L", color=color.new(color.white, 100), textcolor=color.new(tfColor, 0), style=label.style_none, size=size.tiny)
    if not na(highLine) and inRange
        line.set_x2(highLine, bar_index)
        line.set_x2(lowLine, bar_index)
        if not na(midLine)
            line.set_x2(midLine, bar_index)
            if show_eol_labels
                label.set_x(mLabel, bar_index + eol_label_offset), label.set_y(mLabel, mid)
        if show_eol_labels
            label.set_x(hLabel, bar_index + eol_label_offset), label.set_y(hLabel, _high)
            label.set_x(lLabel, bar_index + eol_label_offset), label.set_y(lLabel, _low)

[h0, l0, m0, s0, ir0, nb0] = process_tf(tf_m30)
if use_tf_m30
    plot_lines(tf_m30_color, h0, l0, m0, s0, ir0, nb0, use_tf_m30_mid, "M30")

[h1, l1, m1, s1, ir1, nb1] = process_tf(tf_h1)
if use_tf_h1
    plot_lines(tf_h1_color, h1, l1, m1, s1, ir1, nb1, use_tf_h1_mid, "H1")

[h2, l2, m2, s2, ir2, nb2] = process_tf(tf_h4)
if use_tf_h4
    plot_lines(tf_h4_color, h2, l2, m2, s2, ir2, nb2, use_tf_h4_mid, "H4")

[h3, l3, m3, s3, ir3, nb3] = process_tf(tf_d)
if use_tf_d
    plot_lines(tf_d_color, h3, l3, m3, s3, ir3, nb3, use_tf_d_mid, "D")

[h4, l4, m4, s4, ir4, nb4] = process_tf(tf_w)
if use_tf_w
    plot_lines(tf_w_color, h4, l4, m4, s4, ir4, nb4, use_tf_w_mid, "W")

// ==========================================
// 3. การตั้งค่าราคาเปิดรายวัน (Daily Open)
// ==========================================
var g_DO = "ตั้งค่าราคาเปิดรายวัน (Daily Open)"
show_do         = input.bool(true, "แสดงเส้น Daily Open", group=g_DO)
do_color        = input.color(color.new(color.gray, 40), "สีเส้น Daily Open", group=g_DO)
do_label_color  = input.color(color.new(color.gray, 0), "สีตัวอักษร Day Open", group=g_DO)
do_width        = input.int(1, "ความหนาเส้น", minval=1, group=g_DO)
do_style_input  = input.string("Dashed", "ลักษณะเส้น", options=["Solid", "Dashed", "Dotted"], group=g_DO)

// open ของวันรู้ตั้งแต่ต้นวัน → ใช้ lookahead_on ได้ ไม่ใช่การมองอนาคต
daily_open = request.security(syminfo.tickerid, "D", open, barmerge.gaps_off, barmerge.lookahead_on)
do_line_style = do_style_input == "Solid" ? line.style_solid : do_style_input == "Dashed" ? line.style_dashed : line.style_dotted

var line do_line = na
var label do_label = na
is_new_day = ta.change(time("D")) != 0

if show_do
    if is_new_day
        do_line := line.new(bar_index, daily_open, bar_index, daily_open, color=do_color, width=do_width, style=do_line_style)
        if show_eol_labels
            do_label := label.new(bar_index + eol_label_offset, daily_open, text="Day Open", color=color.new(color.white, 100), textcolor=do_label_color, style=label.style_none, size=size.tiny)

    if not na(do_line)
        line.set_x2(do_line, bar_index)
        if show_eol_labels
            label.set_x(do_label, bar_index + eol_label_offset)
            label.set_y(do_label, daily_open)

// ==========================================
// 4. การตั้งค่า Order Blocks (OB Boxes)
// ==========================================
var g_OB = "ตั้งค่า Order Blocks"
show_ob          = input.bool(true, "แสดง Order Blocks", group=g_OB)
ob_lookback      = input.int(5, "ระยะแท่งย้อนหลังที่ใช้หา", minval=2, group=g_OB)
ob_show_last     = input.int(5, "แสดง OB ล่าสุด (จำนวน)", minval=1, maxval=50, group=g_OB)
bull_ob_color    = input.color(color.new(#4169E1, 85), "สี Bullish OB", group=g_OB)
bear_ob_color    = input.color(color.new(#ff0055, 85), "สี Bearish OB", group=g_OB)

type OrderBlock
    box  bx
    float top
    float bottom
    bool  is_bull
    bool  mitigated

var ob_list = array.new<OrderBlock>(0)

// [แก้] คำนวณ ta.highest / ta.lowest นอก if เพื่อให้ประวัติครบทุกแท่ง
ob_hi = ta.highest(high, ob_lookback)
ob_lo = ta.lowest(low, ob_lookback)

if show_ob
    if high[1] == ob_hi[1] and close < low[1]
        float ob_t = high[1], float ob_b = low[1]
        box b = box.new(bar_index[1], ob_t, bar_index, ob_b, bgcolor=bear_ob_color, border_color=color.new(color.white, 100), extend=extend.right)
        array.unshift(ob_list, OrderBlock.new(b, ob_t, ob_b, false, false))

    if low[1] == ob_lo[1] and close > high[1]
        float ob_t = high[1], float ob_b = low[1]
        box b = box.new(bar_index[1], ob_t, bar_index, ob_b, bgcolor=bull_ob_color, border_color=color.new(color.white, 100), extend=extend.right)
        array.unshift(ob_list, OrderBlock.new(b, ob_t, ob_b, true, false))

    if array.size(ob_list) > 0
        for i = array.size(ob_list) - 1 to 0
            OB = array.get(ob_list, i)
            if not OB.mitigated
                if (OB.is_bull and close < OB.bottom) or (not OB.is_bull and close > OB.top)
                    OB.mitigated := true
                    box.delete(OB.bx)

            if i > ob_show_last or OB.mitigated
                if not na(OB.bx)
                    box.delete(OB.bx)
                array.remove(ob_list, i)

// ==========================================
// 5. การตั้งค่าโครงสร้างตลาด (BOS / MSS)
// ==========================================
var g_MS = "ตั้งค่าโครงสร้างตลาด (Market Structure)"
show_ms         = input.bool(true, "แสดงโครงสร้างตลาด", group=g_MS)
ms_len          = input.int(5, "ระยะ Swing (ย้อนหลัง)", minval=2, group=g_MS)
ms_label_size   = input.string(size.tiny, "ขนาดตัวอักษร", options=[size.tiny, size.small, size.normal], group=g_MS)
// [แก้] สีดำ → สีเทาอ่อน (มองเห็นได้ทั้งธีมสว่างและมืด)
ms_line_color   = input.color(color.new(#9598A1, 40), "สีเส้น BOS/MSS", group=g_MS)
ms_text_color   = input.color(color.new(#B2B5BE, 0), "สีตัวอักษร BOS/MSS", group=g_MS)

var float ph = na, var float pl = na
var int ph_idx = na, var int pl_idx = na
var bool ms_is_bullish = na

nph = ta.pivothigh(high, ms_len, ms_len)
npl = ta.pivotlow(low, ms_len, ms_len)

if not na(nph)
    ph := nph
    ph_idx := bar_index[ms_len]
if not na(npl)
    pl := npl
    pl_idx := bar_index[ms_len]

// [แก้] คำนวณ crossover / crossunder นอก if
brk_up = ta.crossover(close, ph)
brk_dn = ta.crossunder(close, pl)

if show_ms
    if brk_up
        bool is_mss = (ms_is_bullish == false)
        string txt = is_mss ? "MSS" : "BOS"
        line.new(ph_idx, ph, bar_index, ph, color=ms_line_color, style=line.style_solid, width=1)
        label.new(math.round((ph_idx + bar_index) / 2), ph, txt, color=color.new(color.white, 100), textcolor=ms_text_color, style=label.style_label_down, size=ms_label_size, textalign=text.align_center)
        ph := na
        ms_is_bullish := true

    if brk_dn
        bool is_mss = (ms_is_bullish == true)
        string txt = is_mss ? "MSS" : "BOS"
        line.new(pl_idx, pl, bar_index, pl, color=ms_line_color, style=line.style_solid, width=1)
        label.new(math.round((pl_idx + bar_index) / 2), pl, txt, color=color.new(color.white, 100), textcolor=ms_text_color, style=label.style_label_up, size=ms_label_size, textalign=text.align_center)
        pl := na
        ms_is_bullish := false

// ==========================================
// 6. การตั้งค่า Turtle Soup (Liquidity Grab)
// ==========================================
var g_TS = "ตั้งค่า Turtle Soup (ดักทาง Liquidity)"
show_ts           = input.bool(true, "แสดง Turtle Soup", group=g_TS)
ts_lookback       = input.int(20, "ระยะย้อนหลัง (Lookback)", minval=5, group=g_TS)
ts_label_size     = input.string(size.tiny, "ขนาดตัวอักษร TS", options=[size.tiny, size.small, size.normal], group=g_TS)
ts_ext_len        = input.int(10, "ความยาวเส้นที่ยื่นออกมา", minval=1, group=g_TS)
ts_line_color     = input.color(color.new(#9598A1, 50), "สีเส้น TS", group=g_TS)
ts_text_color     = input.color(color.new(#B2B5BE, 0), "สีตัวอักษร TS", group=g_TS)

ts_hi_val = ta.highest(high[1], ts_lookback)
ts_lo_val = ta.lowest(low[1], ts_lookback)

int ts_hi_idx = na
int ts_lo_idx = na

if show_ts
    for i = 1 to ts_lookback
        if high[i] == ts_hi_val
            ts_hi_idx := bar_index[i]
        if low[i] == ts_lo_val
            ts_lo_idx := bar_index[i]

// หมายเหตุ: แบบนี้คือ TWS (กวาดแค่ไส้แล้วปิดกลับในแท่งเดียว)
is_soup_bull = low < ts_lo_val and close > ts_lo_val
is_soup_bear = high > ts_hi_val and close < ts_hi_val

if show_ts
    end_x = bar_index + ts_ext_len
    if is_soup_bull
        line.new(ts_lo_idx, ts_lo_val, end_x, ts_lo_val, color=ts_line_color, style=line.style_dotted, width=1)
        label.new(end_x, ts_lo_val, "TS", color=color.new(color.white, 100), textcolor=ts_text_color, style=label.style_none, size=ts_label_size, textalign=text.align_left, yloc=yloc.price)

    if is_soup_bear
        line.new(ts_hi_idx, ts_hi_val, end_x, ts_hi_val, color=ts_line_color, style=line.style_dotted, width=1)
        label.new(end_x, ts_hi_val, "TS", color=color.new(color.white, 100), textcolor=ts_text_color, style=label.style_none, size=ts_label_size, textalign=text.align_left, yloc=yloc.price)

// ==========================================
// 7. [ใหม่] CRT Signals + Alerts (แบบในวิดีโอ)
//    C1 = แท่ง TF ใหญ่ก่อนหน้า (กรอบ CRH/CRL)
//    C2 = แท่งถัดมา กวาด high หรือ low ของ C1 "ด้านเดียว" แล้วปิดกลับเข้ากรอบ
//    Bear: กวาด CRH → TP1 = 50%, TP2 = CRL     Bull: กวาด CRL → TP1 = 50%, TP2 = CRH
//    ยืนยันตอนแท่ง C2 ปิดแล้วเท่านั้น (ไม่ repaint)
// ==========================================
var g_CRT = "CRT Signals + Alerts"
show_crt     = input.bool(true, "แสดงสัญญาณ CRT", group=g_CRT)
crt_use1     = input.bool(true, "", inline="C1", group=g_CRT)
crt_tf1      = input.timeframe("60", "CRT TF", inline="C1", group=g_CRT)
crt_use2     = input.bool(true, "", inline="C2", group=g_CRT)
crt_tf2      = input.timeframe("240", "CRT TF", inline="C2", group=g_CRT)
crt_quality  = input.bool(true, "Quality: C2 ต้องเปิดในกรอบ C1 (กวาดด้วยไส้เท่านั้น)", group=g_CRT)
crt_bull_col = input.color(#089981, "สี Bull", inline="CC", group=g_CRT)
crt_bear_col = input.color(#F23645, "สี Bear", inline="CC", group=g_CRT)
crt_rng_col  = input.color(#9598A1, "สีกรอบ", inline="CC", group=g_CRT)

crt_tf_name(tf) =>
    sec = timeframe.in_seconds(tf)
    sec < 3600 ? str.tostring(math.round(sec / 60)) + "m" : sec < 86400 ? str.tostring(math.round(sec / 3600)) + "H" : sec < 604800 ? "D" : sec < 2592000 ? "W" : "M"

crt_run(tf, enabled) =>
    // แท่ง TF ใหญ่ที่ปิดแล้ว 2 แท่งล่าสุด: [2] = C1 (กรอบ), [1] = C2 (แท่งกวาด)
    [cT1, cO1, cH1, cL1, cC1, cO2, cH2, cL2, cC2] = request.security(syminfo.tickerid, tf, [time[2], open[2], high[2], low[2], close[2], open[1], high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_on)
    newBar  = ta.change(time(tf)) != 0
    tfOk    = enabled and timeframe.in_seconds(tf) >= timeframe.in_seconds(timeframe.period)
    openIn  = not crt_quality or (cO2 <= cH1 and cO2 >= cL1)
    inside  = cC2 < cH1 and cC2 > cL1
    isBear  = tfOk and newBar and cH2 > cH1 and cL2 >= cL1 and inside and openIn
    isBull  = tfOk and newBar and cL2 < cL1 and cH2 <= cH1 and inside and openIn
    name    = crt_tf_name(tf)

    var line  lnH = na
    var line  lnL = na
    var line  lnM = na
    var label lbH = na
    var label lbL = na
    var label lbM = na
    var int   dir = 0
    var float tp1 = na
    var float tp2 = na
    var float inv = na
    var bool  hit1 = false
    var bool  done = true

    if show_crt and (isBull or isBear)
        line.delete(lnH), line.delete(lnL), line.delete(lnM)
        label.delete(lbH), label.delete(lbL), label.delete(lbM)
        dir  := isBull ? 1 : -1
        tp1  := (cH1 + cL1) / 2
        tp2  := isBull ? cH1 : cL1
        inv  := isBull ? cL2 : cH2
        hit1 := false
        done := false
        dc = isBull ? crt_bull_col : crt_bear_col
        lnH := line.new(cT1, cH1, time, cH1, xloc=xloc.bar_time, extend=extend.right, color=isBear ? dc : crt_rng_col, width=1)
        lnL := line.new(cT1, cL1, time, cL1, xloc=xloc.bar_time, extend=extend.right, color=isBull ? dc : crt_rng_col, width=1)
        lnM := line.new(cT1, tp1, time, tp1, xloc=xloc.bar_time, extend=extend.right, color=dc, style=line.style_dashed, width=1)
        lbH := label.new(bar_index + eol_label_offset, cH1, "CRH " + name + (isBear ? " ▼" : " | TP2"), color=color.new(color.white, 100), textcolor=isBear ? dc : crt_rng_col, style=label.style_label_left, size=size.small)
        lbL := label.new(bar_index + eol_label_offset, cL1, "CRL " + name + (isBull ? " ▲" : " | TP2"), color=color.new(color.white, 100), textcolor=isBull ? dc : crt_rng_col, style=label.style_label_left, size=size.small)
        lbM := label.new(bar_index + eol_label_offset, tp1, "TP1 " + name + " (50%)", color=color.new(color.white, 100), textcolor=dc, style=label.style_label_left, size=size.small)
        alert("📢 CRT " + name + (isBull ? " BULL 🟢" : " BEAR 🔴") + " | " + syminfo.ticker + "\n⚖️ TP1 (50%): " + str.tostring(tp1, format.mintick) + "\n🎯 TP2: " + str.tostring(tp2, format.mintick) + "\n🛑 Invalid: " + str.tostring(inv, format.mintick), alert.freq_once_per_bar)

    if show_crt and not done
        t1hit = dir == 1 ? high >= tp1 : low <= tp1
        t2hit = dir == 1 ? high >= tp2 : low <= tp2
        stop  = dir == 1 ? low < inv : high > inv
        if t1hit and not hit1
            hit1 := true
            label.set_text(lbM, "TP1 " + name + " ✓")
            alert("✅ CRT " + name + " TP1 hit | " + syminfo.ticker + " @ " + str.tostring(tp1, format.mintick), alert.freq_once_per_bar)
        if t2hit
            done := true
            alert("🎯 CRT " + name + " TP2 hit | " + syminfo.ticker + " @ " + str.tostring(tp2, format.mintick), alert.freq_once_per_bar)
        else if stop
            done := true
            alert("🛑 CRT " + name + " invalidated | " + syminfo.ticker, alert.freq_once_per_bar)
        if done
            line.set_extend(lnH, extend.none), line.set_x2(lnH, time)
            line.set_extend(lnL, extend.none), line.set_x2(lnL, time)
            line.set_extend(lnM, extend.none), line.set_x2(lnM, time)
        else
            label.set_x(lbH, bar_index + eol_label_offset)
            label.set_x(lbL, bar_index + eol_label_offset)
            label.set_x(lbM, bar_index + eol_label_offset)
    [isBull, isBear]

[crtBull1, crtBear1] = crt_run(crt_tf1, crt_use1)
[crtBull2, crtBear2] = crt_run(crt_tf2, crt_use2)

plotshape(show_crt and (crtBull1 or crtBull2), "CRT Bull", shape.triangleup, location.belowbar, crt_bull_col, size=size.tiny)
plotshape(show_crt and (crtBear1 or crtBear2), "CRT Bear", shape.triangledown, location.abovebar, crt_bear_col, size=size.tiny)

// สำหรับตั้ง alert แบบเลือกเงื่อนไขเดียว (ทางเลือก นอกจาก "Any alert() function call")
alertcondition(crtBull1 or crtBull2, "CRT Bull", "CRT BULL บน {{ticker}} @ {{close}}")
alertcondition(crtBear1 or crtBear2, "CRT Bear", "CRT BEAR บน {{ticker}} @ {{close}}")

// ==========================================
// 8. CRT Candlestick Logo
// ==========================================
var g_LOGO = "CRT Candlestick Logo"
show_logo = input.bool(true, "แสดงโลโก้ CRT", group=g_LOGO)
// [แก้] สีดำ → สีเทาอ่อน
logo_color = input.color(#B2B5BE, "สีตัวอักษรโลโก้", group=g_LOGO)

if show_logo
    var table logo_tbl = table.new(position.bottom_right, 1, 1)
    table.cell(logo_tbl, 0, 0, "CRT Candlestick", text_color=logo_color, text_size=size.normal, text_halign=text.align_right)
